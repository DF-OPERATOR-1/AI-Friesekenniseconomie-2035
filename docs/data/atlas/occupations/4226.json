[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/CC611492F2", "name": "Receptionist", "description": "Ontvangt bezoekers aan de balie van een bedrijf of instelling. Voorbeelden van werkzaamheden: bedient de telefooncentrale, staat telefonerende mensen te woord en verbindt hen door, verstrekt (in verschillende talen) algemene informatie over de organisatie, ontvangt en registreert bezoekers en begeleidt hen naar de wachtruimte.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/85F8D9B7BB", "name": "Afrekenen", "importance": "optioneel", "description": "Afrekenen van producten of diensten van een klant, geld ontvangen en zo nodig wisselgeld teruggeven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EDEFE5E12E", "name": "Afspraken inplannen", "importance": "essentieel", "description": "Data en tijden zoeken die passen voor een ontmoeting of vergadering. Deelnemers uitnodigen en benodigde ruimtes of middelen reserveren. Bevestigen en eventuele wijzigingen doorgeven aan alle betrokkenen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/53A61B0480", "name": "Bezoekers intern doorverwijzen", "importance": "essentieel", "description": "Helpen van bezoekers door hen naar de juiste plek of persoon binnen het gebouw te begeleiden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AEEB20EED7", "name": "Documenten digitaliseren", "importance": "optioneel", "description": "Omzetten van papieren documenten in digitale bestanden en deze netjes opslaan.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6E8D80F273", "name": "Identiteit- en persoonsgegevens controleren", "importance": "essentieel", "description": "Controleren of documenten zoals paspoorten en ID-kaarten overeenkomen met de gegevens van de klant. Vergelijken van naam, geboortedatum en adres. Signaleren van fouten of afwijkingen. Zorgen dat de gegevens betrouwbaar en actueel zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8D4F0A0D94", "name": "Klachten registreren", "importance": "essentieel", "description": "Klachten van klanten of burgers in een systeem zetten. Beschrijven wat het probleem is en wat er al is gedaan. Zorgen dat de klacht goed wordt opgevolgd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/68D4FDB1C3", "name": "Klantcommunicatie via e-mail", "importance": "optioneel", "description": "Lezen van e-mails van klanten. Beantwoorden van vragen met heldere, correcte en vriendelijke teksten. Zorgen dat alle informatie klopt. Houden van een nette en professionele schrijfstijl.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BB779BAEA8", "name": "Klantcommunicatie via face to face contact", "importance": "essentieel", "description": "Persoonlijk ontvangen en helpen van klanten. Beantwoorden van vragen en oplossen van problemen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3B15C724B9", "name": "Klantcommunicatie via telefoon", "importance": "essentieel", "description": "Beantwoorden van telefoontjes van klanten. Luisteren naar hun vraag of probleem en vriendelijk reageren. Geven van duidelijke informatie of zoeken naar een oplossing. Doorverbinden als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5E0AC8079E", "name": "Klanten informeren", "importance": "essentieel", "description": "Beantwoorden van vragen van klanten en duidelijke informatie geven over producten, diensten of regels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/697A5CF306", "name": "Klanten verwelkomen", "importance": "essentieel", "description": "Ontvangen van klanten op een vriendelijke manier, geven van informatie en zorgen voor een goede eerste indruk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E8F2639145", "name": "Klantvragen analyseren", "importance": "essentieel", "description": "Het bekijken van klantvragen om te begrijpen wat vaak speelt en waar klanten behoefte aan hebben. Het indelen van de vragen in groepen, het zoeken naar patronen en het gebruiken van die informatie om de service of producten te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E7A64B8C6B", "name": "Kopieerwerk verrichten", "importance": "optioneel", "description": "Maken van kopieën van documenten, controleren van de kwaliteit en sorteren voor verder gebruik of verzending.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C9950D618D", "name": "Leveringen controleren", "importance": "optioneel", "description": "Vergelijken van binnengekomen goederen met de pakbon of factuur. Controleren of aantallen kloppen en of er beschadigingen zijn, fouten melden en zorgen voor een juiste afhandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0403165FC9", "name": "Ontvangstruimtes netjes houden", "importance": "essentieel", "description": "Schoonmaken en netjes houden van ontvangstruimtes. Rangschikken van meubels en decoratie en direct opruimen van rommel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/09E595A5F3", "name": "Post en e-mails versturen en archiveren", "importance": "optioneel", "description": "Sturen van post en e-mails naar de juiste personen en netjes opslaan voor later gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32E3CE6E8E", "name": "Post ontvangen en verdelen", "importance": "optioneel", "description": "Ontvangen van de post, sorteren en brengen naar de juiste persoon of afdeling.", "code": ""}, {"uri": "https://linke