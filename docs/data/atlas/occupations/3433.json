[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/CD99486083", "name": "Medewerker behoud en beheer (museum)", "description": "Zorgt voor het behoud en het beheer van de museumcollectie. Maakt voorwerpen uit de collectie schoon (preventieve conservering) en zorgt ervoor dat ze goed worden bewaard. Voorbeelden van werkzaamheden: maakt museale objecten volgens bepaalde richtlijnen schoon, bergt de voorwerpen goed op en houdt een plaatsregistratie bij, pakt de voorwerpen in en uit en is verantwoordelijk voor het transport.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF6AFB2ACF", "name": "Bedrijfsprocedures en werkwijzen toelichten", "importance": "optioneel", "description": "Uitleg geven aan collega’s over taken en regels binnen het bedrijf zodat iedereen goed weet wat te doen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7A32C9C57B", "name": "Bewaring van stukken monitoren", "importance": "essentieel", "description": "Regelmatig controleren of voorwerpen veilig en goed worden bewaard. Meten of temperatuur en luchtvochtigheid in orde zijn. Problemen melden als iets niet klopt. Zorgen dat de collectie goed beschermd blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/561BAA4EF1", "name": "Collecties voor bruikleen inventariseren", "importance": "essentieel", "description": "Een lijst maken van objecten die uitgeleend kunnen worden. De staat, waarde en beschikbaarheid van elk stuk noteren. Controleren of alles goed verzekerd is. Zorgen voor een overzicht van de bruikleenopties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A822FCDED8", "name": "Condities van cultureel erfgoed en kunstobjecten controleren", "importance": "essentieel", "description": "Voorwerpen inspecteren op beschadiging, slijtage of veroudering. Foto’s maken en de staat goed documenteren. Bespreken of er actie nodig is, zoals herstel of verplaatsing. Alles registreren voor behoud en beheer.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32357130B1", "name": "Cultureel erfgoed en kunstobjecten restaureren", "importance": "essentieel", "description": "Beschadigde voorwerpen voorzichtig schoonmaken en herstellen. De juiste materialen en technieken gebruiken. Originele kenmerken zo goed mogelijk behouden. Objecten weer toonbaar en veilig maken voor de toekomst.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7E7A9AFC89", "name": "Erfgoed of collecties inventariseren", "importance": "essentieel", "description": "Alle objecten bekijken en kenmerken zoals materiaal, ouderdom en staat noteren. Foto’s maken van elk voorwerp. Alles invoeren in een database. Zorgen voor een compleet overzicht van de collectie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D876909737", "name": "Informatie- en communicatiemateriaal uitwerken", "importance": "essentieel", "description": "Digitale conten en ook folders, presentaties en nieuwsbrieven ontwerpen en opmaken. Teksten schrijven en beelden kiezen. Controleren of de boodschap duidelijk is voor de doelgroep.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/697A5CF306", "name": "Klanten verwelkomen", "importance": "optioneel", "description": "Ontvangen van klanten op een vriendelijke manier, geven van informatie en zorgen voor een goede eerste indruk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8D406DE340", "name": "Kunststukken en collecties taxeren", "importance": "essentieel", "description": "De waarde van schilderijen, beelden en andere verzamelobjecten beoordelen,rekening houden met zeldzaamheid, kwaliteit en vragen op de markt. Dit vastleggen in een taxatierapport.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/858425979E", "name": "Objecten selecteren als cultureel erfgoed", "importance": "essentieel", "description": "Selecteren van objecten met historische of artistieke waarde. Zorgen voor behoud of tentoonstelling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/066CF40289", "name": "Technische documentatie bijwerken", "importance": "essentieel", "description": "Controleren van technische handleidingen en aanpassen als er informatie ontbreekt of niet meer klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8E73C78AEC", "name": "Toezicht houden op transport van kunstwerken", "importance": "essentieel", "description": "Controleren of kunstwerken goed zijn ingepakt voor vervoer. Toezien op veilig laden, vervoeren en afleveren. Alles registreren in een transportdocument. Problemen of schade meteen melden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F1BD3F7BB1", "name": "Toezicht houden op uitleen/verhuur van stukken uit collecties", "importance": "essentieel", "description": "Bijhouden welke stukken worden uitgeleend of verhuurd. Controleren of de regels goed worden gevolgd. Objecten inspecteren bij terugkomst. Alles netjes registreren in een overzicht.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DBE2ABEF58", "name": "Werkstukken conserveren", "importance": "essentieel", "description": "Reinigen, verpakken en veilig opslaan van werkstukken. Voorkomen van schade of verval.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "belangrijk", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competen