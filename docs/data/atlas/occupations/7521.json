ce": "enigszins", "description": "", "code": "200.0521.01"}, {"uri": "https://linkeddata.competentnl.nl/id/knowledgearea/C34CD6448D", "name": "Veiligheidskunde in de werkomgeving", "importance": "enigszins", "description": "", "code": "200.1022.04"}, {"uri": "https://linkeddata.competentnl.nl/id/knowledgearea/99D6345CD2", "name": "Voorraad- en magazijnbeheer", "importance": "enigszins", "description": "", "code": "200.1041.07"}]}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/59D9F60A6D", "name": "Houtverduurzamer", "description": "Bedient een houtbereidingsinstallatie om hout bestand te maken tegen de invloed van water en weer. Een houtbereidingsinstallatie is een grote, afsluitbare ketel (soms bijna 20 meter lang) met vacuüm- en overdrukpompen. Voorbeelden van werkzaamheden: laadt het te bewerken hout in de installatie, stelt de installatie in, voegt de voorgeschreven hoeveelheid verduurzamingsproducten toe (wolmanzout of creosoot), haalt het verduurzaamde hout uit de ketel, slaat het op of maakt het klaar voor transport.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C2D9B455D8", "name": "Bijzonder afval sorteren en afvoeren", "importance": "optioneel", "description": "Chemisch, elektronisch of medisch afval scheiden volgens de voorschriften. Op veilige wijze in speciale containers plaatsen. Afvoer regelen bij erkende verwerkers.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2B86057F44", "name": "De aard van werkzaamheden bepalen", "importance": "essentieel", "description": "Taken en verantwoordelijkheden van een functie of project in kaart brengen en overleggen met betrokkenen wat er moet gebeuren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/036C07A46A", "name": "De werkplek opruimen en schoonhouden", "importance": "essentieel", "description": "Netjes en schoon houden van de werkplek door op te ruimen, schoon te maken en materialen goed op te bergen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/36F028424D", "name": "Goederen intern transporteren", "importance": "essentieel", "description": "Producten of materialen binnen het bedrijf verplaatsen met heftruck of door handkracht. Correct laden en lossen zonder beschadiging. Routes volgen voor een efficiënte logistiek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E84EC935C3", "name": "Goederen opslaan", "importance": "essentieel", "description": "Geleverde producten controleren op hoeveelheid en kwaliteit. Correct registreren en op de juiste plek in het magazijn plaatsen volgens de regels. Voorraden bijhouden zodat alles op peil blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/65FEA31CA3", "name": "Goederen verpakken", "importance": "essentieel", "description": "Producten veilig en efficiënt inpakken volgens de instructies. Verpakkingsmateriaal kiezen dat past bij het product. Klaarmaken voor verzending of opslag met duidelijke labels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1D12374563", "name": "Houtbewerkingsmachines bedienen", "importance": "essentieel", "description": "Instellen en bedienen van zaag-, schaaf-, frees- en schuurmachines voor houtbewerking. Regelmatig controleren op veiligheid en slijtage en kleine onderhouds- en reinigingswerkzaamheden uitvoeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BEC0303D75", "name": "Milieubewust werken", "importance": "essentieel", "description": "Afval verminderen door materialen te scheiden en hergebruiken waar mogelijk. Energie, water en andere hulpbronnen efficiënt inzetten. Collega’s wijzen op duurzame werkwijzen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2A46B2E650", "name": "Onderdelen op maat maken", "importance": "optioneel", "description": "Materialen zagen, boren, snijden of vormen tot de juiste afmetingen. Werken volgens blauwdrukken en technische tekeningen. Eindproduct controleren op nauwkeurigheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6B430275C7", "name": "Productiegereedschappen (de)monteren en afstellen", "importance": "optioneel", "description": "Gereedschappen voor productie vakkundig monteren en demonteren. Nauwkeurig afstellen zodat machines optimaal werken. Controle uitvoeren op juiste werking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/900A7E3CA7", "name": "Veilig werken", "importance": "essentieel", "description": "Is een manier van werken, geen taak.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/21A4B0D2FF", "name": "Voorraden cont