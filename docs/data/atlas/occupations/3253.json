, "code": "100.004.005.003"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/693D5CC352", "name": "Wetenschappelijk werken", "importance": "enigszins", "description": "", "code": "100.003.002.011"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D5DED5A92E", "name": "Zelfstandig werken", "importance": "essentieel", "description": "", "code": "100.001.001.006"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D6B90E6D17", "name": "Zelfvertrouwen tonen", "importance": "essentieel", "description": "", "code": "100.001.003.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/73CE64DACE", "name": "Zorgvuldig werken", "importance": "belangrijk", "description": "", "code": "100.001.001.014"}]}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/D8639C216D", "name": "Huishoudkundig consulent", "description": "Geeft voorlichting over het huishouden (bijvoorbeeld over huishoudelijke apparatuur, omgang met huishoudgeld, consumentenrecht, milieuzorg, veiligheid en voeding). Voorbeelden van werkzaamheden: maakt voorlichtingsmateriaal, geeft cursussen, houdt lezingen en voorlichtingsavonden, levert bijdragen aan radio- en televisiespots, adviseert (telefonisch, schriftelijk en persoonlijk), stelt actieplannen op, overlegt met collega's, leest vakliteratuur, overlegt met deskundigen en slaat informatie op in de computer.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/F21F4CF753", "name": "Incontinentieconsulent", "description": "Instrueert en adviseert patiënten die incontinent (verlies van urine en ontlasting) zijn. Voorbeelden van werkzaamheden: beantwoordt vragen over zelfzorg, begeleidt de (familie van de) patiënt, instrueert patiënten over opvangmaterialen en informeert de huisarts of schakelt de wijkverpleegkundige in voor hulp.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/E00740D7DF", "name": "Lactatiekundige", "description": "Begeleidt en adviseert moeders bij problemen op het gebied van de borstvoeding. Voorbeelden van werkzaamheden: observeert borstvoeding moeder en kind, adviseert bij weigeren van borstvoeding, borstontstekingen, onvoldoende melkproductie, pijnklachten en het opnieuw beginnen met borstvoeding en geeft cursussen.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/F7137A528B", "name": "Opvoedingsvoorlichter", "description": "Geeft voorlichting over het opvoeden van kinderen. Voorbeelden van werkzaamheden: verzamelt informatie, bepaalt de inhoud en vormgeving van voorlichtingsmateriaal, overlegt met bijvoorbeeld ouders, leerkrachten, artsen, maatschappelijk werkers, psychologen en therapeuten en werkt met (audio)visuele middelen (bijvoorbeeld films en beamer).", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/D0BFFBE965", "name": "Patiëntenvoorlichter", "description": "Licht patiënten voor en fungeert als schakel tussen patiënt en hulpverleners. Voorbeelden van werkzaamheden: organiseert voorlichtingsbijeenkomsten voor patiënten, adviseert artsen, medisch specialisten en verpleegkundigen over het gebruik van bepaalde voorlichtingsmethoden en communicatiemiddelen en oefent medisch personeel in het benaderen van patiënten.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/F896CBC55D", "name": "Vitaloog", "description": "Adviseert organisaties over duurzame inzetbaarheid van mensen binnen organisaties. En coacht mensen om duurzame hun gedrag te veranderen, zodat zij zich gelukkiger, fitter en meer in balans voelen. Vitaliteit heeft te maken met gezonde voeding en beweging maar vooral ook over zingeving en de sociale (werk)omgeving waarin mensen leven en werken. In de aanpak van de vitaloog ligt de nadruk op inspireren, motiveren en bewust wording creëren. Vitaloog is een beschermd beroep en mag alleen gevoerd worden na het behalen van een geaccrediteerde opleiding tot vitaloog. Voorbeelden van werkzaamheden: maakt individuen, teams en organisaties bewust van hun eigen vitaliteit; maakt gebruik van de Vitaliteitsschijf van Vijf om de unieke situatie in kaart te brengen; maakt een aanpak op maat; brengt in kaart wat mensen om zelf kunnen doen om hun vitaliteit te verhogen.", "tasks": [], "skills": []}]
