[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/1DA76A5D47", "name": "Bos- en landschapsadviseur", "description": "Geeft voorlichting en advies aan mensen die werkzaam zijn in de bosbouw of landbouw (bijvoorbeeld akkerbouwers, veetelers en bloementelers). De voorlichting heeft bijvoorbeeld betrekking op nieuwe productiemethoden, economische ontwikkelingen en bedrijfsvoering. Voorbeelden van werkzaamheden: bezoekt boeren en tuinders, geeft cursussen en lezingen, schrijft artikelen voor vakbladen, leest vakbladen, onderhoudt contacten met deskundigen (bijvoorbeeld onderzoekers van proefstations en ambtenaren van het Ministerie van Landbouw, Natuurbeheer en Visserij), verwerkt belangrijke gegevens met vakspecifieke software en bezoekt congressen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "optioneel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "optioneel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C0A898C596", "name": "De uitvoering van een project controleren", "importance": "essentieel", "description": "In de gaten houden of een project goed verloopt. Vergelijken van de planning met de werkelijkheid en bijsturen als er iets misgaat. Zorgen dat het project op tijd en binnen budget blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/11D808A71D", "name": "Digitale maquette vormgeven", "importance": "essentieel", "description": "Van een gebouw of object een 3D-model maken  in BIM- of CAD-software. Materialen, afmetingen en details toevoegen zodat het model voldoet aan de specificaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/94E6448953", "name": "Globale architectonische ontwerpen uitwerken in detail", "importance": "essentieel", "description": "Voorlopig architectonisch ontwerp vertalen naar technische bouwtekeningen waarbijj materialen, afmetingen en constructiedetails vastgelegd worden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1B71132A87", "name": "Haalbaarheidsonderzoek uitvoeren van een project", "importance": "essentieel", "description": "Onderzoeken of een project uitvoerbaar is door te kijken naar kosten, tijd, middelen en kansen op succes.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AA1B6DCAB4", "name": "Klanten begeleiden bij oplevering", "importance": "essentieel", "description": "Uitleg geven aan klanten over werking en functies van het geleverde product of systeem. Vragen beantwoorden en demonstraties geven. Eventuele mankementen oplossen of doorgeven aan support.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B2ED1B828A", "name": "Landschappen inrichten", "importance": "essentieel", "description": "Buitenruimtes vormgeven met planten, paden en vijvers. Bomen, struiken en bloemen planten volgens een ontwerp. Alles netjes aanleggen voor een mooi resultaat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6531DF8B54", "name": "Landschapsarchitectuur projecten ontwerpen", "importance": "essentieel", "description": "Het creëren van ontwerpplannen voor buitenruimtes zoals parken, pleinen en natuurgebieden. Hierbij worden locatieanalyse, vormgeving, materiaal- en beplantingskeuzes geïntegreerd tot een samenhangend ontwerp", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/04F82E147E", "name": "Leveranciers, onderaannemers of dienstverleners selecteren", "importance": "essentieel", "description": "Vergelijken van aanbiedingen van verschillende partijen en kiezen van degene die het beste past bij de wensen van het project.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/24BE97DDEE", "name": "Offertes opstellen", "importance": "optioneel", "description": "Voorbereiden van een overzichtelijke prijsopgave waarin staat wat een product of dienst kost, afgestemd op de wensen van de klant.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2A1FC33103", "name": "Parken inrichten", "importance": "essentieel", "description": "Een ontwerp voor paden, groen en speelplekken in een park maken. De indeling plannen van parken, inclusief de selectie en plaatsing van bomen, struiken, bloemen en andere planten, evenals voorzieningen zoals paden, banken en speeltoestellen. Rekening houden met uitstraling, duurzaamheid en praktisch nut.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B66C1F4E86", "name": "Tuinen inrichten", "importance": "essentieel", "description": "Een tuinplan met planten, paden en meubels ontwerpen. Graven, planten en bestrating leggen volgens het ontwerp. Netjes afwerken en uitleg geven aan de klant over verzorging.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/019BF99DF9", "name": "Uitvoeringsvoorwaarden vaststellen voor een ontwerp", "importance": "essentieel", "description": "Bepalen welke eisen en regels gelden