[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/ED0478973A", "name": "Borstelmaker machinaal", "description": "Maakt in een borstelfabriek (onderdelen van) reinigingsborstels of sorteerborstels voor industriële bedrijven. Voorbeelden van werkzaamheden: bedient (stans)machines, werkt met handgereedschap (bijvoorbeeld bij reparatiewerk), stopt materialen in machines, repareert draadborstels (eissers) en borstelblokken met kunsthaar of dierlijk haar en voert producten af.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B758093EE", "name": "Afwijkingen en productieverstoringen vaststellen", "importance": "essentieel", "description": "Signaleren van fouten of afwijkingen in het productieproces. Documenteren van problemen en onderzoeken van de oorzaak. In kaart brengen van verstoringen om vervolgacties te bepalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/786136FD9A", "name": "Borstels produceren", "importance": "essentieel", "description": "Materialen verwerken tot borstels met de juiste vorm en stevigheid. Machines instellen en bedienen. Het eindresultaat controleren op kwaliteit.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8AA087F82B", "name": "Installaties in werking stellen", "importance": "essentieel", "description": "Een installatie opstarten en alle onderdelen controleren. Instellingen bijstellen als iets niet goed werkt. Zorgen dat alles volgens de regels functioneert.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0304C6BBFC", "name": "Metingen en controles uitvoeren", "importance": "optioneel", "description": "Speciale meetinstrumenten gebruiken om waarden zoals temperatuur of druk vast te leggen. Controleren of uitkomsten aan de norm voldoen. Rapporten maken van meetresultaten. Eventuele afwijkingen melden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BEC0303D75", "name": "Milieubewust werken", "importance": "essentieel", "description": "Afval verminderen door materialen te scheiden en hergebruiken waar mogelijk. Energie, water en andere hulpbronnen efficiënt inzetten. Collega’s wijzen op duurzame werkwijzen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/879FC99124", "name": "Nieuwe machines in dienst nemen", "importance": "optioneel", "description": "Een nieuwe machine installeren en goed testen. Collega’s uitleg geven over het gebruik. Een onderhoudsplan opstellen om storingen te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3FC91D2ACA", "name": "Producten controleren tijdens verschillende fases van productieprocessen", "importance": "essentieel", "description": "Tijdens de productie onderdelen en eindproducten keuren op fouten. Afwijkingen opschrijven en melden. Zo de kwaliteit bewaken tot aan het einde.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/52F6FFC103", "name": "Productieafval sorteren en afvoeren", "importance": "optioneel", "description": "Verschillende soorten afval (papier, plastic, metaal) scheiden volgens de regels. Afval op een veilige en milieuvriendelijke manier afvoeren. Registreren volgens voorschriften.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A3266355FC", "name": "Productieverstoringen oplossen", "importance": "essentieel", "description": "Technische storingen in de productie snel herkennen en analyseren. Direct maatregelen nemen of hulp inschakelen om de storing op te lossen. Zo wordt de normale productie zo snel mogelijk hervat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9CE06E30C6", "name": "Productieverstoringen rapporteren", "importance": "essentieel", "description": "Storingen in het productieproces vastleggen met oorzaak en impact. Oplossingsvoorstel toevoegen en communiceren met betrokkenen. Rapport bewaren voor vervolgacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/900A7E3CA7", "name": "Veilig werken", "importance": "essentieel", "description": "Is een manier van werken, geen taak.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/EDB4E0C35A", "name": "Anticiperen", "importance": "enigszins", "description": "", "code": "100.003.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/4C7E67AD24", "name": "Auditief waarnemen", "importance": "enigszins", "description": "", "code": "100.002.006.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "enigszins", "description": "", "code": "100.003.004.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D71801355A", "name": "Controleren van machines en systemen", "importance": "enigszins", "descript