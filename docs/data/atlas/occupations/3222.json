[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/5FD441082B", "name": "Kraamverpleegkundige", "description": "Assisteert een arts of verloskundige bij bevallingen in het ziekenhuis of thuis. Voorbeelden van werkzaamheden: signaleert in overleg met (de familie van) de patiënt verpleegproblemen, stelt het verpleegplan op, begeleidt en ondersteunt aanstaande ouders, luistert naar de harttonen van baby's, meet de heftigheid van de weeën, geeft medicijnen, legt infusen aan, waarschuwt specialisten en regelt een operatiekamer als er tijdens de bevalling iets misgaat, controleert en wast pasgeborenen, hecht moeders als ze ingeknipt of ingescheurd zijn, geeft instructies over het verzorgen van baby's en schrijft verslagen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7CACCD350A", "name": "(Para)medische informatie uitwisselen", "importance": "essentieel", "description": "Belangrijke (para)medische gegevens veilig delen met collega’s en andere zorgverleners. Controleren op volledigheid en juistheid van de informatie en daarbij de vertrouwelijkheid waarborgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8C441E054F", "name": "Adviseren over verzorging van baby's", "importance": "essentieel", "description": "Ouders tips geven over voeding, slaap en verzorging. Uitleggen wat normaal is in de ontwikkeling. Advies geven bij zorgen of vragen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7A3436E149", "name": "Biomedische toestellen en bewakingstoestellen controleren", "importance": "essentieel", "description": "Apparaten zoals ECG-monitoren en infuuspompen inspecteren en testen. Kalibreren volgens handleiding en storingen melden. Inventaris bijhouden van gebruikte en gecontroleerde instrumenten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6A90B74705", "name": "Bloed afnemen", "importance": "optioneel", "description": "Veilig en hygiënisch prikken bij de patiënt volgens protocol. De juiste buis kiezen, vullen en goed afsluiten. Labelen en transportklaar maken voor het laboratorium.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1D0D73CF66", "name": "De gezondheidstoestand monitoren", "importance": "essentieel", "description": "Vitale functies zoals bloeddruk en hartslag regelmatig meten om gezondheidsproblemen tijdig waar te nemen. Symptomen noteren en afwijkingen melden. Rapport maken voor vervolgbehandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C7C6294342", "name": "Doorverwijzen binnen de zorgverlening", "importance": "optioneel", "description": "Doorsturen van een patiënt naar een andere zorgverlener of instelling als dat nodig is voor verder onderzoek of behandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A592740D0C", "name": "Eigen deskundigheid ontwikkelen", "importance": "essentieel", "description": "Blijven leren door cursussen, training of ervaring op te doen. Volgen van nieuwe ontwikkelingen in het vak en toepassen in het werk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4AE776938E", "name": "Fysieke veiligheid en gezondheid van patiënten bewaken", "importance": "essentieel", "description": "Patiënten regelmatig controleren op comfort en veiligheid. Valrisico’s en drukplekken signaleren. Direct actie ondernemen bij onveilige situaties of verslechtering.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FC5C574933", "name": "Gebruik van medicijnen begeleiden", "importance": "essentieel", "description": "Aan patiënten uitleggen hoe en wanneer medicijnen moeten worden ingenomen. De juiste dosis controleren en bijwerkingen noteren. Op tijd herinneren en melden bij afwijkingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B4889B8F36", "name": "Gegevens registreren in een volgsysteem", "importance": "essentieel", "description": "Invoeren van belangrijke informatie nauwkeurig in een systeem. Mogelijk maken dat de voortgang van klanten, projecten of processen goed gevolgd kan worden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/815A4C87C4", "name": "Gereedschap of materieel reinigen", "importance": "essentieel", "description": "Vuil, vet en andere resten van gereedschap en materiaal verwijderen. Geschikte reinigingsmiddelen kiezen en juiste technieken toepassen. Controleren of alles goed droog en gebruiksklaar is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6AC112CAF9", "name": "Gezondheidsontwikkelingen van baby's monitoren", "importance": "essentieel", "description": "Regelmatig lengte, gewicht en ontwikkeling van baby’s controleren. Alles noteren en vergelijken met groeicurven. Bij zorgen contact opnemen met een arts.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E57B216FB6", "name": "Gynaecologen assisteren bij bevallingen", "importance": "essentieel", "description": "Medische handelingen ondersteunen tijdens de bevalling. De gezondheid van moeder en kind goed in de gaten houden. Snel ingrijpen bij complicaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/066E8CAC15", "name": "Het geven van borstvoeding ondersteunen", "importance": "essentieel", "description": "Moeders helpen bij het aanleggen van hun baby. Oplossingen bieden bij problemen zoals pijn of weinig melk. Steun geven en vragen beantwoorden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E1705D2290", "name": "Informeren over (para)medische behandelingen", "importance": "essentieel", "description": "Duidelijk uitleggen aan patiënten wat een behandeling inhoudt, wat de voordelen en risico’s zijn en welke keuzes er zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C31753D182", "name": "Infusen aanleggen", "importance": "essentieel", "description": "Een naald in een ader plaatsen voor vocht- of medicatietoediening. Katheter bevestigen en controleren op lekkage. Infuusapparaat instellen op de juiste doorloopsnelheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5F627B547F", "name": "Injecties toedienen", "importance": "essentieel", "description": "Voorbereiden van de injectie met de juiste medicatie en dosering. Injectieplek desinfecteren en naald inbrengen volgens protocol. Patiënt observeren op reacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4614CAD3EC", "name": "Katheters inbrengen", "importance": "essentieel", "description": "De steriele katheter voorzichtig in de blaas plaatsen volgens de protocollen en controleren of de katheter goed functioneert.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/64692E5761", "name": "Kinderen meten en wegen", "importance": "essentieel", "description": "Lengte en gewicht van kinderen opmeten met een meetlint en weegschaal. De gegevens vergelijken met groeistandaarden. Afwijkingen bespreken met ouders of artsen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EA7A7D6C52", "name": "Medicijnen toedienen", "importance": "optioneel", "description": "Tabletten, druppels of infusen geven volgens voorschrift en schema. Controleren op juiste patiënt en dosering. Bijwerkingen signaleren en documenteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F21069AC85", "name": "Medisch materiaal voorbereiden", "importance": "essentieel", "description": "Instrumenten en materialen selecteren, ordenen en soms steriliseren. Controleren of alles compleet is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B7A8FFA8D", "name": "Medische administratie verwerken", "importance": "essentieel", "description": "Verwerken van patiëntgegevens en medische informatie volgens de regels. Helpen van medisch personeel met administratieve taken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C2CBF3581F", "name": "Medische dossiers bijhouden", "importance": "essentieel", "description": "Patiëntgegevens verzamelen en ordenen op papier of in het zorgsysteem. Medische geschiedenis, onderzoeken en behandelingen bijhouden. Zorgen dat dossiers altijd compleet en up-to-date zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9F95F8BBA2", "name": "Mensen helpen bij de activiteiten van het dagelijks leven", "importance": "essentieel", "description": "Mensen ondersteunen  bij wassen, aankleden en eten klaarmaken. Medicijnen helpen toedienen en begeleiden naar afspraken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A533D363EF", "name": "Monsters van lichaamsvloeistoffen afnemen", "importance": "optioneel", "description": "Bloed, urine of speeksel op de juiste manier verzamelen en labelen. Hygiëne- en veiligheidsmaatregelen volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1787572A27", "name": "Pijn behandelen", "importance": "optioneel", "description": "Pijnscore meten bij de patiënt en vastleggen. Pijnmedicatie toedienen volgens voorschrift. Effect meten en bijstellen om optimale pijnbestrijding te bereiken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9B0D21085A", "name": "Psychologische steun bieden", "importance": "essentieel", "description": "Luisteren naar zorgen en angsten van cliënten. Tips, therapieën en gesprekstechnieken gebruiken om stress te verlagen. Zo nodig doorverwijzen naar gespecialiseerde hulp.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4DA748959B", "name": "Risico's of noodzorgsituaties vaststellen", "importance": "essentieel", "description": "Herkennen van gevaarlijke of spoedeisende situaties die de gezondheid of veiligheid kunnen bedreigen. Melden en actie ondernemen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EA1A24A37C", "name": "Samenwerken aan een gemeenschappelijk doel", "importance": "essentieel", "description": "Samenwerken met anderen aan een gedeeld doel. Gebruiken van ieders kennis en vaardigheden om het plan samen uit te voeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C3D7FC1D0F", "name": "Uitrusting ontsmetten", "importance": "optioneel", "description": "Goed schoonmaken van gebruikte apparatuur en doden van bacteriën met speciale middelen om besmetting te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0FEFA3FD13", "name": "Verpleegdiagnose stellen", "importance": "essentieel", "description": "Gezondheidstoestand van de patiënt observeren en gegevens verzamelen. Klachten bespreken en vitale functies meten. Op basis daarvan vastleggen welke verpleegkundige zorg nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F0901C7D60", "name": "Verplegen", "importance": "essentieel", "description": "Medicatie toedienen, wonden verzorgen en monitoren van de gezondheidstoestand. Emotionele steun bieden en de patiënt geruststellen. Daarnaast ook dagelijkse zorgtaken uitvoeren,zoals wassen, helpen bij toiletgang en eten geven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0CB04A123A", "name": "Werkdocumenten invullen en gegevens rapporteren", "importance": "essentieel", "description": "Vereiste formulieren en digitale documenten nauwkeurig invullen met werk- en meetgegevens. Informatie doorsturen naar de juiste afdeling of leidinggevende. Deadlines en procedures volgen bij het rapporteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D9FDFB2CB8", "name": "Zelfstandig een bevalling uitvoeren", "importance": "essentieel", "description": "Een bevalling begeleiden van begin tot eind. De gezondheid van moeder en baby volgen. Medische handelingen uitvoeren en eerste zorg geven na de geboorte.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32B4BECF89", "name": "Zorg afstemmen op de sociale en culturele situatie van de patiënt", "importance": "essentieel", "description": "Achtergrond en gewoonten van de patiënt inventariseren. Behandelplan aanpassen aan geloof, taal en leefgewoonten. Zorgen voor begrip en draagvlak bij de patiënt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3C9F7FE401", "name": "Zorgplannen opstellen", "importance": "essentieel", "description": "Zorgbehoeften van de patiënt analyseren. Individueel plan maken met doelen en acties. Regelmatig evalueren en bijstellen voor de beste zorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BAE40237AE", "name": "Zwangere vrouwen begeleiden tijdens bevalling", "importance": "essentieel", "description": "Een vrouw tijdens de bevalling begeleiden en geruststellen. Hulp geven bij ademhaling en omgaan met pijn. Contact houden met het medische team en zorgen voor rust.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/B620732163", "name": "Aandacht en begrip tonen", "importance": "essentieel", "description": "", "code": "100.005.005.001"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "essentieel", "description": "", "code": "100.001.002