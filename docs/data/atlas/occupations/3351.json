[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/AAFEE1A675", "name": "Douaneambtenaar", "description": "Controleert goederen die vanuit andere landen Nederland binnenkomen en verricht soms paspoortcontroles. Voorbeelden van werkzaamheden: controleert ladingspapieren en opslagadministraties, verzegelt ladingen en maakt de daarvoor benodigde papieren in orde, berekent hoeveel invoerbelasting moet worden betaald, controleert of alle verplichte documenten en certificaten aanwezig zijn, controleert bagage op verboden goederen (bijvoorbeeld drugs) en maakt processen-verbaal op.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF6AFB2ACF", "name": "Bedrijfsprocedures en werkwijzen toelichten", "importance": "essentieel", "description": "Uitleg geven aan collega’s over taken en regels binnen het bedrijf zodat iedereen goed weet wat te doen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8EF2E435AA", "name": "Belasting innen op ingevoerde goederen", "importance": "essentieel", "description": "Controleren van goederen en berekenen van invoerrechten. Innen van belastingen volgens wetgeving.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9487EEFD8D", "name": "Bevorderen van kwaliteitsbewustzijn", "importance": "optioneel", "description": "Het stimuleren van medewerkers om zelf te letten op kwaliteit in hun werk. Dit kan via het organiseren van korte trainingen en het geven van tips tijdens het werk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8BE98D848E", "name": "Boekhoudkundige onrechtmatigheden onderzoeken", "importance": "optioneel", "description": "Financiële documenten analyseren en verdachte transacties opsporen. Onderliggende bewijsstukken opvragen. Alles vastleggen in een onderzoeksrapport voor het management.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/99236F45C6", "name": "Dossiers van belastingplichtigen controleren", "importance": "optioneel", "description": "Ingevulde belastingaangiften vergelijken met bijlagen en regels. Kijken naar afwijkingen in inkomsten of aftrekposten. Fouten noteren en in een rapport vastleggen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A3A5584184", "name": "Douanedocumenten en goederen controleren", "importance": "essentieel", "description": "Het vergelijken van papieren zoals vrachtbrieven met de lading, het inspecteren van goederen op aantallen en het keuren van items volgens de regels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3BE88D046B", "name": "Handel in voedings- en industriële producten controleren", "importance": "essentieel", "description": "Het keuren van binnenkomende producten op kwaliteit en veiligheid, het controleren van documentatie en procedures bij ontvangst en opslag, en het rapporteren van onregelmatigheden met corrigerende adviezen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AB72E85994", "name": "Honden geleiden bij bescherm- en opsporingsacties", "importance": "optioneel", "description": "Honden trainen en begeleiden bij taken zoals zoeken naar verdovende middelen of vermiste personen. Leiding geven tijdens acties en veiligheid waarborgen en de resultaten rapporteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FF5D9CA132", "name": "Illegale bedrijfsactiviteiten opsporen", "importance": "essentieel", "description": "Controleren van bedrijven en analyseren van data. Opsporen van fraude of andere overtredingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/185D457317", "name": "Informatie opzoeken", "importance": "essentieel", "description": "Gegevens verzamelen over een onderwerp met boeken, internet en databases. Analysere