nce": "belangrijk", "description": "", "code": "200.0031.06"}]}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/BF3DADF278", "name": "Verhuurmedewerker autoverhuurbedrijf", "description": "Verhuurt personen- en bedrijfsauto's bij een autoverhuurbedrijf. Voorbeelden van werkzaamheden: verhuurt personen- en bedrijfsauto's, verzorgt het interieur en exterieur van de voertuigen, controleert de auto's bij inname, beheert de autosleutels, verricht administratieve werkzaamheden in verband met de verhuur, staat klanten te woord en adviseert hen over producten en verhuurdiensten en bedient de kassa.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EA3F295A2B", "name": "Aanvragen in behandeling nemen", "importance": "essentieel", "description": "Controleren van aanvragen op volledigheid en juistheid. Verwerken van aanvragen en zetten van vervolgstappen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF52A15FCF", "name": "Activiteiten plannen van een wagenpark", "importance": "optioneel", "description": "Maken van een ritten- en onderhoudsschema voor voertuigen. Rekening houden met beschikbaarheid van chauffeurs en auto’s. Aanpassen van planning bij onverwachte wijzigingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2AC82E47BF", "name": "Activiteitsgegevens bijhouden", "importance": "essentieel", "description": "Registreren van datum, tijd en duur van werkzaamheden. Noteren van betrokken personen en gebruikte middelen. Bijhouden van een overzicht voor rapportage en planning.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7DD329141B", "name": "Administratieve dossiers samenstellen", "importance": "essentieel", "description": "Verzamelen en ordenen van documenten om een volledig en overzichtelijk dossier te maken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/85F8D9B7BB", "name": "Afrekenen", "importance": "essentieel", "description": "Afrekenen van producten of diensten van een klant, geld ontvangen en zo nodig wisselgeld teruggeven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/70C299C810", "name": "Contracten administratief beheren", "importance": "essentieel", "description": "Contractdocumenten ordenen en archiveren. Deadlines voor verlenging of beëindiging in de gaten houden. Tijdig informeren bij veranderingen of acties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D5299A4730", "name": "Contracten opstellen", "importance": "essentieel", "description": "Maken van duidelijke en rechtsgeldige afspraken tussen twee of meer partijen. Vastleggen in een contract wie wat moet doen en zorgen dat alles volgens de wet is geregeld.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D70E3604CA", "name": "De kas opmaken", "importance": "optioneel", "description": "Tellen van het geld in de kassa aan het eind van de dag en controleren of het klopt met de administratie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "optioneel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A592740D0C", "name": "Eigen deskundigheid ontwikkelen", "importance": "optioneel", "description": "Blijven leren door cursussen, training of ervaring op te doen. Volgen van nieuwe ontwikkelingen in het vak en toepassen in het werk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/10FE97787E", "name": "Geschillendossiers samenstellen", "importance": "essentieel", "description": "Verzamelen en ordenen van alle informatie over een conflict in een dossier dat wordt gebruikt in een juridische procedure.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4EBDEBA63D", "name": "Inventarissen opmaken", "importance": "optioneel", "description": "Registreren van alle aanwezige spullen binnen een bedrijf. Noteren van aantallen, locaties en waarden. Maken van een overzichtelijke lijst voor beheer en controle.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8D4F0A0D94", "name": "Klachten registreren", "importance": "essentieel", "description": "Klachten van klanten of burgers in een systeem zetten. Beschrijven wat het probleem is en wat er al is gedaan. Zorgen dat de klacht goed wordt opgevolgd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01A85925B6", "name": "Klanten informeren over de huurvoorwaarden", "importance": "essentieel", "description": "Aan klanten huurprijs, looptijd en borg duidelijk uitleggen. Verantwoordelijkheden bij schade of inlevering beschrijven. Vragen beantwoorden en zorgen dat de klant alle afspraken begrijpt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EB2AB4BBC2", "name": "Klanten ondersteunen bij ingebruikname van voertuigen of materieel", "importance": "optioneel", "description": "Uitleg over de bediening en veiligheid van nieuwe voertuigen of machines. De belangrijkste functies demonstreren en eventuele vragen beantwoorden. Daar waar nodig klanten laten proefdraaien.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/697A5CF306", "name": "Klanten verwelkomen", "importance": "essentieel", "description": "Ontvangen van klanten op een vriendelijke manier, geven van informatie en zorgen voor een goede eerste indruk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BC64C558E9", "name": "Klantrelaties beheren", "importance": "essentieel", "description": "Opbouwen en onderhouden van een goede band met klanten. Luisteren naar hun wensen, oplossen van klachten en zorgen dat ze tevreden blijven en terugkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E8F2639145", "name": "Klantvragen analyseren", "importance": "essentieel", "description": "Het bekijken van klantvragen om te begrijpen wat vaak speelt en waar klanten behoefte aan hebben. Het indelen van de vragen in groepen, het zoeken naar patronen en het gebruiken van die informatie om de service of producten te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/042D49E070", "name": "Nieuwe klanten acquireren", "importance": "essentieel", "description": "Zoekt actief naar nieuwe klanten en zorgt dat ze producten of diensten gaan afnemen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D6C392D67C", "name": "Producten of diensten op maat presenteren aan de klant", "importance": "essentieel", "description": "Luistert naar de wensen van de klant en laat daarna op een duidelijke manier zien wat het beste bij hem of haar past.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0C2D4A3F30", "name": "Professionele netwerken uitbouwen", "importance": "essentieel", "description": "Bouwt relaties op met mensen en organisaties die belangrijk kunnen zijn voor het werk en onderhoudt deze relaties, bijvoorbeeld via netwerkbijeenkomsten of sociale media.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5ED4FDC0BF", "name": "Promotieacties uitvoeren", "importance": "essentieel", "description": "Marketing- en promotieactiviteiten uitvoeren om producten of diensten onder de aandacht te brengen, bijvoorbeeld via reclamecampagnes, evenementen of speciale aanbiedingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5C736C3F94", "name": "Technische oplossingen bieden", "importance": "essentieel", "description": "Technische problemen of vragen analyseren en  een passende oplossing bedenken, rekening houdend met ontwerp, installatie of onderhoud. De oplossing implementeren en controleren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B3574C7EB3", "name": "Voertuigen en/of materieel verhuren", "importance": "essentieel", "description": "De staat van het te verhuren voertuig en/of materieelhet controleren  bij uitgifte en inname. Een huurovereenkomst opstellen met tarieven en voorwaarden. Onderhoud en reparaties op tijd inplannen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9A46BD9864", "name": "Voertuigen klaarmaken voor aflevering", "importance": "essentieel", "description": "Nieuwe of gereviseerde voertuigen controleren, schoonmaken en vloeistoffen bijvullen. Bandenspanning en verlichting checken. Opmaken van overdrachtsrapport voor de klant.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9B7A99ABA2", "name": "Werking van materieel controleren", "importance": "essentieel", "description": "Apparaten, machines en hulpmiddelen inspecteren op veiligheid en functionaliteit. Testen of alle functies correct werken. Defecte onderdelen melden voor reparatie.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/24653064A5", "name": "Acquireren", "importance": "enigszins", "description": "", "code": "100.006.002.004"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "n