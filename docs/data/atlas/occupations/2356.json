[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/2CA7E60DEA", "name": "Praktijkopleider / trainer informatica", "description": "Begeleidt leerling-werknemers, cursisten, trainees en stagiairs (deelnemers) in een bedrijf en zorgt ervoor dat alles op de werkvloer zo is geregeld dat ze een goede praktijkopleiding krijgen. Werkt in het primaire arbeidsproces van het bedrijf en verricht de werkzaamheden als praktijkopleider meestal als neventaak. Geeft les, ontwikkelt en organiseert cursussen en trainingen en stelt praktijkleerplannen op. Voorbeelden van werkzaamheden: werft en selecteert geschikte deelnemers, stelt introductieprogramma's op en verzorgt deze, informeert medewerkers over de komst van de deelnemers, instrueert en begeleidt deelnemers, onderhoudt contacten met betrokken partijen, bewaakt de vorderingen van deelnemers en beoordeelt deelnemers.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F79A9AD815", "name": "Cursisten evalueren", "importance": "essentieel", "description": "Toetsen of observeren hoeveel een cursist geleerd heeft. Gebruiken van toetsen, opdrachten of gesprekken. Geven van duidelijke en opbouwende feedback. Helpen bij het verbeteren van leerprestaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8BB42D330F", "name": "Didactische methodes en instrumenten voor opleidingen omschrijven", "importance": "essentieel", "description": "Het bedenken en beschrijven van effectieve lesmethodes en hulpmiddelen voor onderwijs.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3A4B8249CD", "name": "Evaluaties verbeteren", "importance": "essentieel", "description": "Bekijken hoe toetsen of beoordelingen nu worden afgenomen. Problemen of onduidelijkheden opsporen. Voorstellen doen om vragen of manier van beoordelen te verbeteren. Helpen om de evaluaties eerlijker en duidelijker te maken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/57F582EDE7", "name": "Leerklimaat en -omgeving afstemmen op cursisten", "importance": "essentieel", "description": "Kijken wat cursisten nodig hebben om goed te leren. Aanpassen van de lesruimte, zoals licht, stoelen of rust. Bedenken welke werkvormen het beste passen bij de groep. Zorgen dat iedereen zich prettig voelt tijdens het leren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E50A2A5F6B", "name": "Lesgeven informatica", "importance": "essentieel", "description": "Het geven van les in programmeren en softwareontwikkeling. Het beoordelen van studentenwerk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0F7C1B0873", "name": "Medewerkers opleiden in methodes en technieken van de onderneming", "importance": "essentieel", "description": "Ontwikkelen van een interne training. Uitleggen van werkwijzen en standaarden. Begeleiden van medewerkers tijdens het leerproces.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/58B98DCBA0", "name": "Opleidingen promoten", "importance": "optioneel", "description": "Uitleggen waarom een opleiding nuttig is en wat iemand ermee leert. Flyers, e-mails of berichten maken om aandacht te trekken. Informatie delen via internet, nieuwsbrieven of presentaties. Beantwoorden van vragen van mensen die interesse hebben.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5D325C2CEB", "name": "Opleidingsmodules samenstellen", "importance": "essentieel", "description": "Ontwerpt en ontwikkelt lesmodules. Kiest passend materiaal en een goede lesvorm.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EB1A4B8D80", "name": "Opleidingsprogramma's samenstellen", "importance": "essentieel", "description": "Het samenstellen van lesmodules, werkvormen en materialen, het plannen van volgorde en duur, en het beschrijven van doelstellingen en evaluatiemethoden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/97B2E6787E", "name": "Opleidingswerkplekken superviseren", "importance": "essentieel", "description": "Het begeleiden van stagiaires op de werkvloer. Het geven van uitleg over taken, het controleren van hun werk en het geven van feedback.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8152A3FE56", "name": "Werkplekleren organiseren", "importance": "essentieel", "description": "Afspreken welke leerdoelen op de werkplek gehaald worden. Koppelen van cursisten aan passende afdelingen of bedrijven. Zorgen voor goede begeleiding en duidelijke afspraken. Inplannen van momenten voor evaluatie.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/B620732163", "name": "Aandacht en begrip tonen", "importance": "belangrijk", "description": "", "code": "100.005.005.001"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/24653064A5", "name": "Acquireren", "importance": "enigszins", "description": "", "code": "100.006.002.004"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "essentieel", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/CECB22E3FA", "name": "Adviseren", "importance": "essentieel", "description": "", "code": "100.005.005.003"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/EDB4E0C35A", "name": "Anticiperen", "importance": "belang