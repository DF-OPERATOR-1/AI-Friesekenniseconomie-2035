[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/82A8914DC2", "name": "Opperman / oppervrouw bouw", "description": "Assisteert vakmensen op een bouwplaats. Voorbeelden van werkzaamheden: voert bouwmaterialen aan (bijvoorbeeld stenen), stapelt stenen, zaagt stenen op maat, maakt specie, helpt steigers bouwen, sorteert materiaal, graaft sleuven, smeert gereedschappen, maakt gereedschappen schoon en ruimt het bouwterrein op.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E64A3F143F", "name": "Bouwplaatsen beveiligen", "importance": "essentieel", "description": "Omheining en slagbomen plaatsen rond de bouwplaats. Toegang controleren en sloten gebruiken. Cameratoezicht en verlichting installeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/815A4C87C4", "name": "Gereedschap of materieel reinigen", "importance": "essentieel", "description": "Vuil, vet en andere resten van gereedschap en materiaal verwijderen. Geschikte reinigingsmiddelen kiezen en juiste technieken toepassen. Controleren of alles goed droog en gebruiksklaar is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/36F028424D", "name": "Goederen intern transporteren", "importance": "essentieel", "description": "Producten of materialen binnen het bedrijf verplaatsen met heftruck of door handkracht. Correct laden en lossen zonder beschadiging. Routes volgen voor een efficiënte logistiek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CF004A13C9", "name": "Goederen lossen", "importance": "essentieel", "description": "Transportvoertuig openen en goederen veilig uitladen. Controlelijst afvinken en producten naar de juiste opslagplek brengen. Beschadigingen melden en rapporteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/883560A385", "name": "Grondverzetwerken uitvoeren", "importance": "essentieel", "description": "Grond verplaatsen met een graafmachine, bulldozer of kiepwagen. Sleuven graven of kuilen opvullen volgens het plan. Rekening houden met opslag- en stortlocaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A1E2B68C16", "name": "Hechtmiddelen (mortel, lijm, plamuur) aanmaken", "importance": "essentieel", "description": "Mengen van grondstoffen tot een bruikbaar product. Volgen van de juiste verhoudingen. Controleren van de dikte of verwerkbaarheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/835DAE2F2C", "name": "Sleuven in muren maken", "importance": "essentieel", "description": "Met hamer en beitel of slijpmachine groeven uitslijpen. Diepte en breedte volgen de technische specificaties. Vegen en stofvrij maken voor het inleggen van leidingen of kabels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A3F2ADF274", "name": "Sloopwerkzaamheden uitvoeren", "importance": "essentieel", "description": "Muren, vloeren of constructies gecontroleerd afbreken. Veiligheidsmaatregelen volgen met steigers en afzettingen. Puin afvoeren volgens milieuregels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/606BEC13E4", "name": "Steigers monteren", "importance": "optioneel", "description": "Steigeronderdelen zoals frames en planken volgens bouwtekening in elkaar zetten en controleren of de steiger stevig staat en voldoet aan de veiligheidsregels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4041343FC3", "name": "Terreinen afgraven", "importance": "essentieel", "description": "Graafmachines of schoppen gebruiken om grond weg te halen. Diepte en breedte volgens plan aanhouden. Grond afvoeren of opslaan voor hergebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6045B638DC", "name": "Terreinen ophogen", "importance": "essentieel", "description": "Grond, zand of andere materialen op een specifiek terrein aanbrengen tot de juiste hoogte. Het materiaal verdelen met een shovel en verdichten met een trilplaat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/900A7E3CA7", "name": "Veilig werken", "importance": "essentieel", "description": "Is een manier van werken, geen taak.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D98DF019F7", "name": "Werkplekken opruimen", "importance": "essentieel", "description": "Materiaal en gereedschap verzamelen en ordenen na het werk. Afval en reststukken verwijderen en vloer en werkblad schoonmaken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E799C262B1", "name": "Werkterrein inrichten", "importance": "essentieel", "description": "Looproutes, gereedschap en materialen logisch plaatsen. Veiligheidsborden en afzettingen neerzetten. Controleren of alles klaarstaat voor start van de werkzaamheden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/877CAB2A7C", "name": "Werkzaamheden op werklocaties voorbereiden", "importance": "essentieel", "description": "Materialen, gereedschap en personeel op tijd plannen en verzamelen. Locatie veilig maken met bordjes of afzetting.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/EDB4E0C35A", "name": "Anticiperen", "importance": "belangrijk", "description": "", "code": "100.003.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "enigszins", "description": "", "code": "100.003.004.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/A710CD8B16", "name": "Digitale tools en apps gebruiken", "importance": "enigszins", "description": "", "code": "100.004.004.003"}, {"uri": "https://linkeddata.competentnl.