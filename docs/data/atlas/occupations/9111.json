[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/22C491EF77", "name": "Hulp in de particuliere huishouding", "description": "Helpt mensen thuis bij huishoudelijke werkzaamheden. Werkt als zelfstandige of in dienst van bijvoorbeeld een schoonmaakbedrijf of gezinsverzorgingsinstelling. Voorbeelden van werkzaamheden: ruimt op, maakt schoon, doet de (af)was, strijkt, haalt boodschappen, kookt en verzorgt planten.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F287F80655", "name": "Bedden opmaken", "importance": "essentieel", "description": "Schoon beddengoed netjes op een bed leggen. Kussens en dekens goed neerleggen. Controleren of alles fris en netjes is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/815A4C87C4", "name": "Gereedschap of materieel reinigen", "importance": "essentieel", "description": "Vuil, vet en andere resten van gereedschap en materiaal verwijderen. Geschikte reinigingsmiddelen kiezen en juiste technieken toepassen. Controleren of alles goed droog en gebruiksklaar is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/290B86D187", "name": "Handdoeken vervangen", "importance": "optioneel", "description": "Vuile handdoeken ophalen en schone ophangen. Zorgen dat er genoeg aanwezig zijn. Alles netjes en op de juiste plek leggen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B7E8C153C5", "name": "Kamers schoonmaken", "importance": "essentieel", "description": "In kamers meubels afstoffen, vloeren stofzuigen en waar nodig dweilen. Beddengoed verschonen en ramen en sanitair reinigen. De kamer netjes en fris achterlaten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E9DBA1BD58", "name": "Kwaliteitsvol, veilig, gezond en milieubewust werken", "importance": "essentieel", "description": "Zorg dragen voor de uitvoering van werkzaamheden volgens kwaliteitsstandaarden. Daarbij veiligheidsvoorschriften en gezondheidsnormen volgen en met een minimale belasting van het milieu.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D2B60BB806", "name": "Meubilair onderhouden", "importance": "essentieel", "description": "Controleren, reinigen, beschermen en repareren van meubels met passende middelen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/98E639F17F", "name": "Ramen reinigen", "importance": "essentieel", "description": "Ramen schoonmaken met water en schoonmaakmiddel. Strepen en vlekken verwijderen. De ramen helder en netjes achterlaten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/749DB3707A", "name": "Sanitaire voorzieningen schoonmaken", "importance": "essentieel", "description": "Toiletten, wastafels en douches schoonmaken met desinfectiemiddel. Voorraad van toiletpapier, zeep en handdoeken aanvullen. Controleren of alles schoon en fris is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4FE1358BAA", "name": "Stof afnemen", "importance": "essentieel", "description": "Met een doek stof verwijderen van meubels of apparaten. Alle oppervlakken netjes schoonmaken. Zorgen dat de ruimte er fris uitziet.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/B620732163", "name": "Aandacht en begrip tonen", "importance": "belangrijk", "description": "", "code": "100.005.005.001"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/23E59C8755"