[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/DCBFF8F66D", "name": "Fysiotherapie-assistent", "description": "Werkt aan de balie van een praktijk voor fysiotherapie. Voorbeelden van werkzaamheden: ontvangt patiënten, controleert papieren (bijvoorbeeld verwijsbriefjes en ziekenfondskaarten) van patiënten, helpt patiënten bij het aan- en uitkleden, vult patiëntenkaarten in, maakt rekeningen op, verwerkt declaraties voor ziekenfondsen, registreert betalingen, beheert voorraden behandel- en oefenmateriaal, onderhoudt telefonisch contact met patiënten, houdt afspraken bij, spreekt het antwoordapparaat in, zet koffie en thee en houdt de wachtruimte schoon.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/4A7906C19A", "name": "Ontspanningsmasseur", "description": "Masseert mensen thuis, in een sauna of in de eigen praktijk om geestelijke en lichamelijke ontspanning te bereiken. Vermindert pijn/stress klachten als gevolg van o.a. verkeerde lichaamshouding. Kan klachten voorkomen/verhelpen zoals (spannings)-hoofdpijn, spijsverteringsklachten, rugklachten, zware benen en RSI- klachten. Voorbeelden van werkzaamheden: gebruikt diverse massagetechnieken. Strijkt en kneedt huid, maakt bindweefsel, spieren, pezen en gewrichten soepeler, verbetert de bloedsomloop van de spieren en de huid en stimuleert de afvoer van afvalstoffen uit het lichaam. ", "tasks": [], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/B620732163", "name": "Aandacht en begrip tonen", "importance": "essentieel", "description": "", "code": "100.005.005.001"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/24653064A5", "name": "Acquireren", "importance": "enigszins", "description": "", "code": "100.006.002.004"}, {"uri": "https://li