[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/2B4D17C5D0", "name": "Confectiemedewerker (naaien)", "description": "Verricht eenvoudig confectiewerk in een fabriek of confectieatelier. Zet delen van textielproducten (bijvoorbeeld huishoudlinnen of beddengoed) in elkaar met halfautomatische naaimachines. Voorbeelden van werkzaamheden: stelt de halfautomatische naaimachines in en bedient deze, voert stofonderdelen aan en zorgt ervoor dat deze in de juiste positie liggen, stikt en naait stoffen aan elkaar, verhelpt eenvoudige storingen aan machines, controleert de kwaliteit van het eindproduct en houdt de eigen werkplek schoon.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F0429C4222", "name": "Controleren of aan productienormen wordt voldaan", "importance": "optioneel", "description": "Producten en processen vergelijken met vastgestelde kwaliteitseisen. Eventuele afwijkingen signaleren en rapporteren. Meedenken over verbeteringen om normen blijvend te behalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/036C07A46A", "name": "De werkplek opruimen en schoonhouden", "importance": "optioneel", "description": "Netjes en schoon houden van de werkplek door op te ruimen, schoon te maken en materialen goed op te bergen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B3DC6FFB87", "name": "Documentatie raadplegen over de opdracht en de productieaanpak", "importance": "essentieel", "description": "Beschikbare handleidingen en tekeningen lezen om duidelijkheid te krijgen over de opdracht. Processtappen en technische vereisten bestuderen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "optioneel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/25D8910BDE", "name": "Gemonteerde textiel of confectieartikelen afwerken", "importance": "essentieel", "description": "Knopen, ritsen of andere sluitingen aan kleding bevestigen. Naden en stiksels controleren op foutjes. Losse draadjes afwerken en kleine fouten herstellen. Zorgen dat het kledingstuk netjes en klaar is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B8260683A8", "name": "Machines afstellen", "importance": "essentieel", "description": "Uitleg toevoegen? Kalibreren houdt in dat metingen en instellingen van een machine worden gecontroleerd en aangepast", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C32CB57BE", "name": "Machines bevoorraden", "importance": "essentieel", "description": "Materialen, grondstoffen of onderdelen tijdig bijvullen in machines. Controleren of de juiste voorraadhoeveelheden aanwezig zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F135375D35", "name": "Producten na bereiding verpakken", "importance": "optioneel", "description": "Warme of gekoelde producten hygiënisch verpakken in geschikte materialen. De verpakking goed sluiten en voorzien van label. Alles klaarzetten voor transport of opslag.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/52F6FFC103", "name": "Productieafval sorteren en afvoeren", "importance": "optioneel", "description": "Verschillende soorten afval (papier, plastic, metaal) scheiden volgens de regels. Afval op een veilige en milieuvriendelijke manier afvoeren. Registreren volgens voorschriften.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FF19016781", "name": "Productieverloop bewaken", "importance": "essentieel", "description": "Continu de voortgang van het productieproces volgen. Productie- en kwaliteitsgegevens bijhouden. Bij vertragingen of fouten snel actie ondernemen om op schema te blijven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A3266355FC", "name": "Productieverstoringen oplossen", "importance": "essentieel", "description": "Technische storingen in de productie snel herkennen en analyseren. Direct maatregelen nemen of hulp inschakelen om de storing op te lossen. Zo wordt de normale productie zo snel mogelijk hervat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9CE06E30C6", "name": "Productieverstoringen rapporteren", "importance": "essentieel", "description": "Storingen in het productieproces vastleggen met oorzaak en impact. Oplossingsvoorstel toevoegen en communiceren met betrokkenen. Rapport bewaren voor vervolgacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DC99E90B62", "name": "Snelheid en spanning van machines regelen", "importance": "essentieel", "description": "Instellingen van machines aanpassen voor de juiste draaisnelheid en spanning. Metingen en alarmen in de gaten houden. Bij afwijkingen meteen ingrijpen. De productie veilig en goed laten verlopen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AA2A10EADA", "name": "Storingen diagnosticeren", "importance": "essentieel", "description": "Technische problemen in machines, apparatuur of systemen onderzoeken. Oorzaken achterhalen en passende oplossingen voorstellen om het werk te kunnen hervatten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4F98FB27A6", "name": "Storingen opsporen", "importance": "optioneel", "description": "Technische fouten in systemen of apparatuur traceren met hulpmiddelen. Oorzaken vastleggen en documenteren om inzicht te bieden voor een oplossing.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3B44C12B4D", "name": "Stukken positioneren volgens markeringen", "importance": "essentieel", "description": "Objecten of onderdelen op de werkplek plaatsen op de aangegeven markeringen. Controleren of de afstand en positie exact kloppen. Zo nodig bijstellen voor nauwkeurige montage.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/39679C22D9", "name": "Textielonderdelen aan elkaar stikken", "importance": "essentieel", "description": "Stofdelen met de hand of met een naaimachine aan elkaar stikken. Zorgen dat de naden netjes en stevig zijn. Controleren of alles volgens het patroon is gemaakt. Het kledingstuk nauwkeurig afwerken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/900A7E3CA7", "name": "Veilig werken", "importance": "essentieel", "description": "Is een manier van werken, geen taak.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/164BC90E69", "name": "Veiligheid van installaties controleren", "importance": "essentieel", "description": "Technische installaties inspecteren op gevaren en op het voldoen aan wettelijke eisen. Beveiliging 