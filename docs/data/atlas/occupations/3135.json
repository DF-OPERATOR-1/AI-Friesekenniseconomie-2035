[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/8CC51F5A73", "name": "Operator smelten erts, staal, non-ferro", "description": "Bewaakt fysische en chemische processen in een metaalbedrijf. Maakt deel uit van een team dat verantwoordelijk is voor de voortgang van (een deel van) het productieproces. Voorbeelden van werkzaamheden: controleert vanachter een beeldscherm de meet- en regelapparatuur die het proces bewaakt en registreert, start het proces op en stopt het proces, regelt productieprocessen in via instrumentenpanelen of via regelpanelen op de installaties zelf en rapporteert bevindingen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B758093EE", "name": "Afwijkingen en productieverstoringen vaststellen", "importance": "essentieel", "description": "Signaleren van fouten of afwijkingen in het productieproces. Documenteren van problemen en onderzoeken van de oorzaak. In kaart brengen van verstoringen om vervolgacties te bepalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F0429C4222", "name": "Controleren of aan productienormen wordt voldaan", "importance": "essentieel", "description": "Producten en processen vergelijken met vastgestelde kwaliteitseisen. Eventuele afwijkingen signaleren en rapporteren. Meedenken over verbeteringen om normen blijvend te behalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "optioneel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B3DC6FFB87", "name": "Documentatie raadplegen over de opdracht en de productieaanpak", "importance": "essentieel", "description": "Beschikbare handleidingen en tekeningen lezen om duidelijkheid te krijgen over de opdracht. Processtappen en technische vereisten bestuderen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/58E23A0CF1", "name": "Doorstroom controleren van materiaal of producten", "importance": "essentieel", "description": "Volgen van het productieproces. Controleren of alles goed verloopt. Ingrijpen bij afwijkingen of vertragingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/40B23D453C", "name": "Emissies controleren", "importance": "essentieel", "description": "Meten van uitgestoten stoffen. Vergelijken met de milieunormen. Rapporteren van afwijkingen en adviseren over verbeteringen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/768FE22301", "name": "Geautomatiseerde productieapparatuur af- en omstellen", "importance": "essentieel", "description": "Instellingen van robots en machines aanpassen voor een nieuw product. Apparatuur na gebruik veilig uitschakelen. Controleren of alle aanpassingen correct werken voor starten van de productie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/03F73A14A2", "name": "Grondstoffen controleren", "importance": "optioneel", "description": "Inspecteren en testen van grondstoffen. Controleren of ze voldoen aan de eisen. Melden van afwijkingen of fouten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E99A505C5E", "name": "Installaties configureren en afstellen", "importance": "essentieel", "description": "Technische systemen zoals klimaat- of beveiligingsinstallaties instellen op juiste waarden. Software en parameters bijstellen. Controleren op correcte werking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C32CB57BE", "name": "Machines bevoorraden", "importance": "essentieel", "description": "Materialen, grondstoffen of onderdelen tijdig bijvullen in machines. Controleren of de juiste voorraadhoeveelheden aanwezig zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2808E2AE1E", "name": "Machines of apparatuur onderhouden", "importance": "essentieel", "description": "Onderhoud uitvoeren: onderdelen controleren, repareren of vervangen. Storingspreventie toepassen om uitval te voorkomen. Onderhoudsrapport bijhouden voor nazorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/75AC45547D", "name": "Machines of installaties starten en monitoren", "importance": "essentieel", "description": "Opstartprocedures volgen voor veilige inbedrijfstelling. Tijdens gebruik de prestaties en eventuele afwijkingen nauwlettend volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0304C6BBFC", "name": "Metingen en controles