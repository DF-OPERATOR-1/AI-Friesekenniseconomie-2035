[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/0BB96D8721", "name": "Corrector", "description": "Controleert teksten die persklaar zijn gemaakt (bijvoorbeeld tijdschriften, kranten en boeken) op fouten en verbetert die. Voorbeelden van werkzaamheden: controleert of teksten voldoen aan de 'huisregels' en aan de officiële spelling, controleert bijvoorbeeld woordafbrekingen, onderschriften, tabelnummering, feitelijke gegevens (namen, data, berekeningen), geeft verbeteringen aan met correctietekens, raadpleegt naslagwerken (woordenboek, het Groene Boekje, encyclopedieën, vaktermenboeken), houdt vakliteratuur bij en controleert of zetinstructies zijn opgevolgd.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0A5983D9E8", "name": "Criteria bepalen voor de correctie van documenten", "importance": "optioneel", "description": "Het opstellen van regels voor spelling, stijl en opmaak, het beschrijven van te corrigeren fouten, en het vastleggen van kwaliteitsbeoordelingscriteria.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/633A290D60", "name": "Documenten bewerken volgens aantekeningen van uitgever en auteur", "importance": "essentieel", "description": "Het verwerken van alle opmerkingen en wijzigingen van uitgever en auteur, en het controleren na elke aanpassing of de tekst vloeiend blijft lezen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6E361E67D1", "name": "Documenten en afbeeldingen selecteren uit databanken", "importance": "optioneel", "description": "Het zoeken in digitale archieven naar de juiste bestanden en het selecteren van foto’s of documenten passend bij het project.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EBE70804AC", "name": "Documenten opmaken", "importance": "optioneel", "description": "Het maken van professionele rapporten, brieven of presentaties in tekstverwerkers