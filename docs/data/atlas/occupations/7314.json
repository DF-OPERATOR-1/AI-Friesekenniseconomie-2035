[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/9BD5FFFA3C", "name": "Modelleur keramische industrie", "description": "Maakt gietvormen voor aardewerkfabrikanten. Voorbeelden van werkzaamheden: maakt schetsen, mengt gips in menginstallaties, maakt modellen van gips of kunststof en geeft ze vorm (bijvoorbeeld met beitels, gutsen en messen), controleert vormen met meetgereedschap, maakt gipsen afdrukken van modellen (moedervormen), maakt mantels die om de moedervorm passen, maakt gipsen gietvormen van mantels en werkt gietvormen af.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1811265252", "name": "Aan industrieel gereedschap en matrijzen werken", "importance": "optioneel", "description": "Ontwerpen, maken en onderhouden van gereedschap en matrijzen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C3B214D361", "name": "Aardewerk bakken", "importance": "essentieel", "description": "Klei vormen tot het gewenste ontwerp en volledig laten drogen. De stukken aardewerk in een keramiekoven plaatsen. Ze bakken op hoge temperatuur tot ze hard en duurzaam zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3368792922", "name": "Administratie voeren", "importance": "optioneel", "description": "Verzamelen, ordenen en bewaren van financiële gegevens op een overzichtelijke manier. Bijhouden van inkomsten en uitgaven, maken van facturen en voorbereiden van belastingaangiften. Zorgen dat de administratie compleet is en financieel klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D1C3254E8B", "name": "Ambachtelijke productiestappen bepalen", "importance": "essentieel", "description": "Bedenken welke stappen nodig zijn om een product handmatig te maken. Beschrijven van gebruikte technieken en materialen. Plannen van de volgorde van de werkzaamheden. Helpen om het proces soepel en efficiënt te laten verlopen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/49722DCE1C", "name": "Antiek keramiek restaureren", "importance": "optioneel", "description": "Barsten of ontbrekende delen in antiek keramiek onderzoeken. Herstellen met speciaal kneedmiddel of kit. Kleuren bijwerken zodat het object er origineel uitziet.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3B1D8F2B83", "name": "Decoraties en glazuur aanbrengen op keramische producten", "importance": "essentieel", "description": "Versieren van keramiek met glazuur en decoraties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/616D54CCE4", "name": "Decoratieve objecten maken", "importance": "essentieel", "description": "Decoratieve objecten zoals sieraden, beeldhouwwerken en/of textielkunst, ontwerpen en maken van materialen zoals hout of metaal. Zorgen dat het eindproduct sterk en mooi afgewerkt is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/68EE5E70E7", "name": "Gebruiksvoorwerpen ontwerpen", "importance": "optioneel", "description": "Ontwerpen van producten voor dagelijks gebruik. Rekening houden met functie en productie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/824B3455C5", "name": "Keramiekelementen plaatsen", "importance": "essentieel", "description": "Voor het plaatsen van keramiekelementen de ondergrond van de gewenste locatie voorbereiden en lijm of kit aanbrengen. Tegels, panelen of sculpturen nauwkeurig plaatsen. Afvoegen en afwerken voor een stevig en waterdicht resultaat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/401C21B6AD", "name": "Keramische pasta vormgeven", "importance": "essentieel", "description": "Keramische pasta kneden, snijden of draaien in de gewenste vorm. De stukken laten drogen en eventueel glazuur aanbrengen. Voorbereiden op het bakken in de oven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3039369D4D", "name": "Kunstwerken vormgeven", "importance": "optioneel", "description": "Nieuwe kunstwerken zoals schilderijen, beelden of installaties bedenken en schetsen. Materialen en technieken kiezen die passen bij het concept. In fases van ontwerp naar eindproduct werken vanuit eigen ideeën of in opdracht van klanten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0D8C651B8C", "name": "Materialen kiezen", "importance": "essentieel", "description": "De projecttekening lezen en bepalen welke materialen nodig zijn. Opties vergelijken op prijs en duurzaamheid. Materialen kiezen die het doel het beste dienen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C524A0C98E", "name": "Onderdelen assembleren", "importance": "essentieel", "description": "Samenvoegen van losse componenten tot een compleet product volgens werktekening. Bouten, lijm of klemmen gebruiken voor stevige verbindingen. Eindresultaat controleren op nauwkeurigheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DF19E36DF9", "name": "Poeders, plastische of vloeibare pasta's samenstellen", "importance": "essentieel", "description": "Ingrediënten afmeten volgens recepturen en mengen tot een egale massa voor het samenstellen van poeders, plastische of vloeibare pasta's. De consistentie controleren en verhoudingen aanpassen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/76F2D2F8E6", "name": "Producten etaleren", "importance": "optioneel", "description": "Goederen in de winkel of showroom op een aantrekkelijke manier presenteren. Kiezen van een goede volgorde, kleur en hoogte.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/61EAD947F3", "name": "Producten of diensten verkopen", "importance": "optioneel", "description": "Zoeken van klanten, presenteren van een aanbod en zorgen dat de verkoop doorgaat. Verkopen van zoveel mogelijk producten of diensten als doel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DA2ACF997B", "name": "Producten promoten", "importance": "optioneel", "description": "Marketingacties bedenken zoals proefmonsters of flyers, evenementen organiseren en opzetten. Contact met (potentiële) klanten onderhouden en resultaten bijhouden om te kijken wat goed werkt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/737381A9C3", "name": "Synthetische materialen vormgeven", "importance": "optioneel", "description": "Producten of onderdelen uit synthetische materialen, zoals  kunststoffen of polymeren, ontwerpen en maken met technieken zoals gieten of 3D-printen. Zorgen dat het materiaal de juiste vorm en sterkte krijgt.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "belangrijk", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/3EEDCD8A87", "name": "Bereiden en samenstellen van ingrediënten", "importance": "belangrijk", "description": "", "code": "100.002.004.007"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "belang