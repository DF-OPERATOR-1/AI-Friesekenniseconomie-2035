[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/DC743ED9B8", "name": "Medewerker klantenservice", "description": "Informeert klanten over producten en diensten en behandelt klachten. Werkt bij de klantenservice van een organisatie. Dat kan zijn in een klant contact centrum (o.a. via email, chat, social media, etc., of telefonisch) of aan een klantenservicebalie. Voorbeelden van werkzaamheden: geeft informatie en advies, beantwoordt vragen, lost problemen op, helpt klanten om artikelen te retourneren of hun aankoop te wijzigen, behandelt klachten, neemt bestellingen op en legt gegevens vast in de computer.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7100586609", "name": "Bestellingen opnemen van klanten", "importance": "essentieel", "description": "Noteren van bestellingen van klanten en correct invoeren in het systeem. Bevestigen van de bestelling zodat de klant weet wat hij kan verwachten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/56FB27999F", "name": "Bestellingen plaatsen", "importance": "optioneel", "description": "Controleren van de voorraad en bestellen van de juiste producten of diensten op het juiste moment en bij de juiste leverancier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ADBC9697EA", "name": "Bestellingen registreren", "importance": "optioneel", "description": "Nieuwe bestelorders invoeren in het systeem. Gegevens controleren op juistheid (aantallen, artikelen en klantinformatie) en eventueel orderbevestiging versturen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/173FDD353D", "name": "Complexe problemen voorleggen aan interne technische specialisten", "importance": "optioneel", "description": "Beschrijven van ingewikkelde technische vragen of storingen. Verzamelen van alle informatie die nodig is om het probleem goed uit te leggen. Voorleggen van de vraag aan gespecialiseerde collega’s. Overleggen over mogelijke oplossingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5B82AFA352", "name": "Contact onderhouden met klanten over technische staat van producten", "importance": "optioneel", "description": "Bellen of mailen met klanten over hun apparatuur. Uitleg geven over de technische staat of voortgang van een reparatie. Beantwoorden van vragen en geven van advies. Maken van afspraken voor controle of onderhoud.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/29E89C679D", "name": "Feedback van klanten verzamelen", "importance": "essentieel", "description": "Bij klanten navraag doen naar hun ervaring met de geleverde producten of service. Deze feedback noteren en verwerken in een verslag.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/15DE815713", "name": "Gebruikers informeren over gebruik van producten of systemen", "importance": "essentieel", "description": "Uitleggen aan klanten hoe een product of systeem stap voor stap werkt. Beantwoorden van vragen en zorgen dat alles duidelijk is voor goed gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B4889B8F36", "name": "Gegevens registreren in een volgsysteem", "importance": "essentieel", "description": "Invoeren van belangrijke informatie nauwkeurig in een systeem. Mogelijk maken dat de voortgang van klanten, projecten of processen goed gevolgd kan worden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D68CA5224C", "name": "Helpdeskvragen behandelen", "importance": "essentieel", "description": "Klanten helpen bij technische of algemene vragen. Oplossingen geven of doorverwijzen naar collega’s. Altijd vriendelijk en duidelijk blijven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6E8D80F273", "name": "Identiteit- en persoonsgegevens controleren", "importance": "essentieel", "description": "Controleren of documenten zoals paspoorten en ID-kaarten overeenkomen met de gegevens van de klant. Vergelijken van naam, geboortedatum en adres. Signaleren van fouten of afwijkingen. Zorgen dat de gegevens betrouwbaar en actueel zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7C9AD23B1A", "name": "Klachten behandelen", "importance": "essentieel", "description": "Serieus nemen van klachten van klanten, registreren en zoeken naar een passende oplossing. Ervoor zorgen dat het probleem in de toekomst kan worden voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/198B44D6B5", "name": "Klantcommunicatie via chat", "importance": "essentieel", "description": "Reageren op klantvragen via chatsoftware. Geven van korte en duidelijke antwoorden. Snel reageren en vriendelijk blijven. Oplossen van problemen of doorverwijzen naar de juiste afdeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/68D4FDB1C3", "name": "Klantcommunicatie via e-mail", "importance": "essentieel", "description": "Lezen van e-mails van klanten. Beantwoorden van vragen met heldere, correcte en vriendelijke teksten. Zorgen dat alle informatie klopt. Houden van een nette en professionele schrijfstijl.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BB779BAEA8", "name": "Klantcommunicatie via face to face contact", "importance": "essentieel", "description": "Persoonlijk ontvangen en helpen van klanten. Beantwoorden van vragen en oplossen van problemen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1AFB1F9809", "name": "Klantcommunicatie via social media", "importance": "essentieel", "description": "Lezen van berichten of reacties op platforms zoals Facebook of Instagram. Reageren op vragen of klachten met korte en nette teksten. Beantwoorden van vragen over producten of diensten. Bewaken van de uitstraling van het bedrijf.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3B15C724B9", "name": "Klantcommunicatie via telefoon", "importance": "essentieel", "description": "Beantwoorden van telefoontjes van klanten. Luisteren naar hun vraag of probleem en vriendelijk reageren. Geven van duidelijke informatie of zoeken naar een oplossing. Doorverbinden als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5E0AC8079E", "name": "Klanten informeren", "importance": "essentieel", "description": "Beantwoorden van vragen van klanten en duidelijke informatie geven over producten, diensten of regels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C6D52655EC", "name": "Klanten informeren over de status van hun bestelling", "importance": "essentieel", "description": "In het systeem kijken waar de bestelling van de klant  is. De klant tijdig en op een duidelijke manier op de hoogte brengen. De communicatie zo nodig vastleggen in het dossier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/95CC897EBC", "name": "Klanten informeren over problemen, aanpassingen en herstellingen", "importance": "optioneel", "description": "Uitleggen wat er aan de hand is met een product of dienst. Vertellen welke aanpassing of reparatie wordt uitgevoerd. Informeren over de verwachte duur en het resultaat. Antwoorden op vragen van de klant.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DAB11B1414", "name": "Klanten of publiek adviseren", "importance": "essentieel", "description": "Geven van duidelijke uitleg en advies aan klanten of bezoekers. Helpen om goede keuzes te maken op basis van wensen of vragen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E8F2639145", "name": "Klantvragen analyseren", "importance": "essentieel", "description": "Het bekijken van klantvragen om te begrijpen wat vaak speelt en waar klanten behoefte aan hebben. Het indelen van de vragen in groepen, het zoeken naar patronen en het gebruiken van die informatie om de service of producten te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D4266B2F77", "name": "Online producten verkopen", "importance": "optioneel", "description": "Nieuwe producten met foto’s en duidelijke beschrijvingen in de webshop plaatsen. Bestellingen beheren en zorg dat de verzending soepel verloopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8E4727B6FA", "name": "Online-verkopen beheren (e-commerce)", "importance": "optioneel", "description": "De voorraad in de webshop bijhouden en nieuwe bestellingen verwerken. Vragen beantwoorden van klanten via chat of e-mail. De site optimaliseren voor zoekmachines zodat meer mensen de webwinkel vinden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/069C83CB40", "name": "Producten en diensten aanbieden", "importance": "optioneel", "description": "Bekijken wat klanten nodig hebben en voorstellen van passende producten of diensten om hen goed te helpen en de verkoop te verhogen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D6C392D67C", "name": "Producten of diensten op maat presenteren aan de klant", "importance": "essentieel", "description": "Luistert naar de wensen van de klant en laat daarna op een duidelijke manier zien wat het beste bij hem of haar past.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/61EAD947F3", "name": "Producten of diensten verkopen", "importance": "optioneel", "description": "Zoeken van klanten, presenteren van een aanbod en zorgen dat de verkoop doorgaat. Verkopen van zoveel