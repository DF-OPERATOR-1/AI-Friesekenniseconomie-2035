[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/A025F0314B", "name": "Butler", "description": "Geeft leiding aan het huishouden van particulieren en verricht huishoudelijk werk. Voorbeelden van werkzaamheden: ontvangt gasten, dekt tafels en ruimt deze af, serveert dranken en gerechten, onderhoudt de tuin en treedt op als chauffeur. Doet schoonmaakwerkzaamheden in huis of besteed deze uit.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F287F80655", "name": "Bedden opmaken", "importance": "essentieel", "description": "Schoon beddengoed netjes op een bed leggen. Kussens en dekens goed neerleggen. Controleren of alles fris en netjes is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1FC71583EF", "name": "Boodschappen doen volgens instructies", "importance": "essentieel", "description": "Een lijst met producten volgen en alles inkopen. Op de juiste merken en hoeveelheden letten. Alles netjes terugbrengen op tijd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/84BD464A1B", "name": "Gerechten en dranken serveren", "importance": "essentieel", "description": "Eten en drinken in de juiste volgorde en op de juiste temperatuur uitserveren. Nagaan of alles naar wens is en leeg servies opruimen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/815A4C87C4", "name": "Gereedschap of materieel reinigen", "importance": "essentieel", "description": "Vuil, vet en andere resten van gereedschap en materiaal verwijderen. Geschikte reinigingsmiddelen kiezen en juiste technieken toepassen. Controleren of alles goed 