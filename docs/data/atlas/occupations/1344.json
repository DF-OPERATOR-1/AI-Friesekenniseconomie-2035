[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/772D5A11BB", "name": "Zorgmanager instelling maatschappelijk werk", "description": "Geeft leiding aan teamleiders van meerdere afdelingen of diensten van een instelling voor maatschappelijk werk. Voorbeelden van werkzaamheden: stelt een jaarplan op, ontwikkelt maatschappelijk beleid, draagt een visie op maatschappelijk werk uit, bewaakt en beheert het budget, biedt medewerkers opleidingen aan, houdt zich op de hoogte van nieuwe ontwikkelingen in de wet- en regelgeving, adviseert het bestuur van de instelling, onderhoudt contacten met collega-managers en vertegenwoordigt de instelling in landelijke, regionale en lokale commissies en projectgroepen voor beleidsontwikkeling.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "essentieel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AD1F0C0FBE", "name": "Beleids- en adviesrapportages opstellen", "importance": "essentieel", "description": "Schrijven van rapporten met advies op basis van onderzoek en gegevens om beleid of beslissingen te ondersteunen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2649A308DE", "name": "Communicatieacties organiseren", "importance": "essentieel", "description": "Plannen en uitvoeren van acties om een boodschap over te brengen, zoals een campagne, evenement of persbericht. Regelen dat dit goed verloopt en de juiste mensen bereikt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/13C59E254D", "name": "Financieel beleid bepalen", "importance": "essentieel", "description": "Budgetregels en richtlijnen opstellen en vastleggen voor uitgaven, investeringen en risicobeheer met het doel een gezonde financiële situatie op korte en lange termijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6466F53F06", "name": "Intern communiceren over activiteiten van organisaties", "importance": "essentieel", "description": "Nieuws en updates binnen de organisatie delen via e-mail, intranet of bijeenkomsten. Zorgen dat medewerkers weten wat er speelt en wat er van hen verwacht wordt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7F47B0F51D", "name": "Kwaliteit van de dienstverlening monitoren en verbeteren", "importance": "essentieel", "description": "Het verzamelen van klantfeedback en het meten van KPI’s zoals wachttijd en foutpercentage, het analyseren van de data, het opstellen van verbeterplannen en het evalueren van de voortgang.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F6EFD3DD9E", "name": "Operationele doelstellingen uitwerken in processen", "importance": "essentieel", "description": "Strategische doelstellingen vertalen naar concrete stappen en procedures. Bepalen wie welke taak uitvoert en met welke middelen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3982DECD5C", "name": "Personeelsbeleid uitvoeren", "importance": "essentieel", "description": "Maken van regels en procedures voor werving, training en beoordeling van medewerkers. Toetsen of alles volgens de wet en afspraken verloopt en beleid evalueren en verbeteren waar nodig.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D1C6298EA8", "name": "Toepassingen van procedures controleren", "importance": "essentieel", "description": "Controleren of werkafspraken goed worden g