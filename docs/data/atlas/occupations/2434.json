[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/CF7200B855", "name": "Accountmanager it", "description": "Realiseert en onderhoudt commerciële relaties met (mogelijke) klanten en afnemers van ict-producten (bijvoorbeeld automatiseringsproducten en -trajecten). Realiseert de verkoop- en omzetdoelstellingen van het bedrijf. Voorbeelden van werkzaamheden: stelt verkoop-, relatie- en accountplannen op en realiseert deze, onderhoudt contacten met klanten (accounts/prospects) en met medewerkers binnen het eigen bedrijf, werft nieuwe klanten, informeert en adviseert klanten, volgt marktontwikkelingen, signaleert en benut verkoopmogelijkheden, voert onderhandelingen en sluit contracten af.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/1F7A1F581B", "name": "Pre-sales consultant ICT", "description": "Bedenkt, samen met collega’s, de beste ICT-oplossingen voor klanten en werkt deze zowel technisch als financieel uit. Adviseert vanuit specifieke technische kennis bij de invulling van strategische vraagstukken. Voorbeeld van werkzaamheden: werkt complexe vraagstukken uit en zet deze om naar concrete voorstellen en is ook betrokken bij de realisatie daarvan, ondersteunt en adviseert collega’s bij hun (verkoop)activiteiten, draagt concrete oplossingen aan, weet klantwensen goed te inventariseren en is mede verantwoordelijk voor een (vaste) groep relaties.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7157A5F0E5", "name": "Behandeling van orders monitoren", "importance": "essentieel", "description": "In de gaten houden van het hele orderproces: van bestelling tot levering. Controleren of alles goed verloopt en oplossen van problemen als die zich voordoen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B18DFD8627", "name": "Commerciële acties uitvoeren", "importance": "essentieel", "description": "Bedenken en uitvoeren van acties om meer te verkopen. Toepassen van kortingen, promoties of speciale aanbiedingen om klanten aan te trekken en te behouden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E414ECA2E6", "name": "Commerciële opdrachten binnenhalen", "importance": "essentieel", "description": "Actief zoeken naar nieuwe klanten en kansen. Maken en presenteren van een aantrekkelijk aanbod om klanten te overtuigen. Het doel is het binnenhalen van nieuwe opdrachten en zorgen voor meer omzet.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A6E4F98918", "name": "Computerhard- en software verkopen", "importance": "essentieel", "description": "Luisteren naar wat de klant nodig heeft en geven van advies over passende computers en software. Maken van een offerte, afronden van de verkoop en zorgen voor een goede afhandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1456264F77", "name": "Contracten onderhandelen", "importance": "essentieel", "description": "Bespreekt contractvoorwaarden met de andere partij om binnen de mogelijkheden tot goede afspraken te komen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/15DE815713", "name": "Gebruikers informeren over gebruik van producten of systemen", "importance": "essentieel", "description": "Uitleggen aan klanten hoe een product of systeem stap voor stap werkt. Beantwoorden van vragen en zorgen dat alles duidelijk is voor goed gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7FF5F8244B", "name": "Klant- en marktonderzoek doen", "importance": "essentieel", "description": "Verzamelt en bekijkt informatie over klantgedrag, concurrenten en trends, zodat de organisatie betere keuzes kan maken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DAB11B1414", "name": "Klanten of publiek adviseren", "importance": "