[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/B1627623A7", "name": "Heftruckchauffeur", "description": "Bestuurt een heftruck en vervoert goederen over korte afstanden. Werkt in het magazijn van bedrijven en op bedrijfsterreinen en haventerreinen. Voorbeelden van werkzaamheden: verplaatst goederen, laadt en lost vrachten, pakt goederen in, werkt volgens geldende veiligheidsvoorschriften, verricht onderhoudswerkzaamheden aan de heftruck en verhelpt kleine storingen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FF677D2E22", "name": "Afwijkingen melden", "importance": "essentieel", "description": "Tijdens het werk letten op fouten of dingen die anders gaan dan gepland. Afwijkingen snel doorgeven aan de verantwoordelijke. Zo zorgen voor een veilige en goede uitvoering.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/43666677E4", "name": "Bestellingen voorbereiden", "importance": "optioneel", "description": "Gekochte producten verzamelen in het magazijn volgens de bestelbonnen. Artikelen controleren op kwaliteit en hoeveelheid. Veilig en netjes inpakken met de juiste labels en verzendinformatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "optioneel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/36F028424D", "name": "Goederen intern transporteren", "importance": "essentieel", "description": "Producten of materialen binnen het bedrijf verplaatsen met heftruck of door handkracht. Correct laden en lossen zonder beschadiging. Routes volgen voor een efficiënte logistiek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0E47D375E8", "name": "Goederen laden", "importance": "essentieel", "description": "Goederen volgens laadlijst selecteren en in het voertuig plaatsen. Zware lasten veilig vastsjorren en belading controleren. Laden zo ordenen dat het vervoer stabiel blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CF004A13C9", "name": "Goederen lossen", "importance": "essentieel", "description": "Transportvoertuig openen en goederen veilig uitladen. Controlelijst afvinken en producten naar de juiste opslagplek brengen. Beschadigingen melden en rapporteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/27A16B9916", "name": "Goederen sorteren", "importance": "essentieel", "description": "Producten opdelen op maat, soort of kwaliteit. Classificeren volgens codes of kleurmarkeringen om verzending of verdere verwerking te vergemakkelijken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8E6311AB69", "name": "Goederenbehandelingsmachines selecteren en voorbereiden", "importance": "essentieel", "description": "Een machine kiezen die past bij de lading, zoals een heftruck of palletwagen. Controleren of de machine goed werkt. Klaarmaken voor gebruik, inclusief brandstof of veiligheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F8814DD91D", "name": "Heftruck besturen", "importance": "essentieel", "description": "Rijden met een heftruck om goederen en materialen te veilig te verplaatsen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4EBDEBA63D", "name": "Inventarissen opmaken", "importance": "essentieel", "description": "Registreren van alle aanwezige spullen binnen een bedrijf. Noteren van aantallen, locaties en waarden. Maken van een overzichtelijke lijst voor beheer en controle.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5E232E8B93", "name": "Lasten met hef- en hijstoestellen optillen", "importance": "essentieel", "description": "Hef- en hijsmiddelen gebruiken om zware spullen veilig op te tillen. Zorgen dat banden en haken goed vastzitten. De werkvoorschriften en veiligheidsregels volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2134FDAD9B", "name": "Lasten verplaatsen met een machine", "importance": "essentieel", "description": "Gebruik maken van een heftruck of kraan om zware spullen te verplaatsen. Zorgen dat de lading stevig vastzit en veilig getild wordt. De veiligheidsinstructies volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C9950D618D", "name": "Leveringen controleren", "importance": "optioneel", "description": "Vergelijken van binnengekomen goederen met de pakbon of factuur. Controleren of aantallen kloppen en of er beschadigingen zijn, fouten melden en zorgen voor een juiste afhandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FD9E3A1C44", "name": "Materialen ordenen", "importance": "essentieel", "description": "Materialen sorteren op soort, grootte of gebruik. Alles zo neerzetten dat het snel en makkelijk te vinden is. Dit helpt om het werk vlot en overzichtelijk te laten verlopen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/447BFF21AD", "name": "Productielijnen bevoorraden", "importance": "optioneel", "description": "Aanleveren van materialen en grondstoffen aan productielijnen om stilstand te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E605DF5564", "name": "Status van ladingen controleren", "importance": "essentieel", "description": "In het systeem kijken waar vrachtwagens of containers zijn met de verzonden goederen. De planning vergelijken en vertragingen noteren. De voortgang rapporteren aan de planners.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0CB04A123A", "name": "Werkdocumenten invullen en gegevens rapporteren", "importance": "essentieel", "description": "Vereiste formulieren en digitale documenten nauwkeurig invullen met werk- en meetgegevens. Informatie doorsturen naar de juiste afdeling of leidinggevende. Deadlines en procedures volgen bij het rapporteren.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "enigszins", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "enigszins", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/EDB4E0C35A", "name": "Anticiperen", "importance": "belangrijk", "description": "", "code": "100.003.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/4C7E67AD24", "name": "Auditief waarnemen", "importance": "enigszins", "description": "", "code": "100.002.006.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "enigszins", "description": "", "code": "100.003.004.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/22799303D1", "