[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/9B71CCAE61", "name": "Verkoopmedewerker tankstation", "description": "Verkoopt artikelen in een tankstation. Voorbeelden van werkzaamheden: informeert en adviseert klanten over hun aankopen, verkoopt artikelen (bijvoorbeeld tijdschriften, snoep, bloemen, autoaccessoires en brandstof), rekent af, behandelt klachten, bedient autowasinstallaties, voert kleine reparaties uit (bijvoorbeeld lampen vervangen), houdt de winkel en het terrein schoon en netjes (door opruimen, stoffen en stofzuigen), registreert inkomende en verbruikte goederen en plaatst ze in het magazijn of in de winkel, presenteert de artikelen op een aantrekkelijke manier en houdt in de gaten of het assortiment past bij wat de klanten willen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/85F8D9B7BB", "name": "Afrekenen", "importance": "essentieel", "description": "Afrekenen van producten of diensten van een klant, geld ontvangen en zo nodig wisselgeld teruggeven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/56FB27999F", "name": "Bestellingen plaatsen", "importance": "optioneel", "description": "Controleren van de voorraad en bestellen van de juiste producten of diensten op het juiste moment en bij de juiste leverancier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D70E3604CA", "name": "De kas opmaken", "importance": "optioneel", "description": "Tellen van het geld in de kassa aan het eind van de dag en controleren of het klopt met de administratie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1DDCD2E519", "name": "De staat van bederfelijke producten controleren", "importance": "optioneel", "description": "Bederfelijke producten zoals vlees, zuivel en groenten nakijken op versheid en houdbaarheid. Controleren op kleur, geur en verpakking. Niet-goede producten uit de schappen halen volgens de regels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/29E89C679D", "name": "Feedback van klanten verzamelen", "importance": "optioneel", "description": "Bij klanten navraag doen naar hun ervaring met de geleverde producten of service. Deze feedback noteren en verwerken in een verslag.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E84EC935C3", "name": "Goederen opslaan", "importance": "essentieel", "description": "Geleverde producten controleren op hoeveelheid en kwaliteit. Correct registreren en op de juiste plek in het magazijn plaatsen volgens de regels. Voorraden bijhouden zodat alles op peil blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4EBDEBA63D", "name": "Inventarissen opmaken", "importance": "optioneel", "description": "Registreren van alle aanwezige spullen binnen een bedrijf. Noteren van aantallen, locaties en waarden. Maken van een overzichtelijke lijst voor beheer en controle.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DAB11B1414", "name": "Klanten of publiek adviseren", "importance": "essentieel", "description": "Geven van duidelijke uitleg en advies aan klanten of bezoekers. Helpen om goede keuzes te maken op basis van wensen of vragen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/697A5CF306", "name": "Klanten verwelkomen", "importance": "essentieel", "description": "Ontvangen van klanten op een vriendelijke manier, geven van informatie en zorgen voor een goede eerste indruk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C9950D618D", "name": "Leveringen controleren", "importance": "essentieel", "description": "Vergelijken van binnengekomen goederen met de pakbon of factuur. Controleren of aantallen kloppen en of er beschadigingen zijn, fouten melden en zorgen voor een juiste afhandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D085327883", "name": "Onverkoopbare producten verwijderen", "importance": "essentieel", "description": "Producten die beschimmeld, beschadigd of over de houdbaarheidsdatum zijn, opsporen en uit de verkoop halen. Verantwoord afvoeren volgens wet- en regelgeving, bijvoorbeeld via recycling of afvalverwerking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/580E449A82", "name": "Opruimen en schoonmaken", "importance": "essentieel", "description": "Schoon en netjes maken van ruimtes door bijvoorbeeld te stofzuigen, af te stoffen en afval weg te gooien.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/76F2D2F8E6", "name": "Producten etaleren", "importance": "optioneel", "description": "Goederen in de winkel of showroom op een aantrekkelijke manier presenteren. Kiezen van een goede volgorde, kleur en hoogte.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/61EAD947F3", "name": "Producten of diensten verkopen", "importance": "essentieel", "description": "Zoeken van klanten, presenteren van een aanbod en zorgen dat de verkoop doorgaat. Verkopen van zoveel mogelijk producten of diensten als doel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/46F0A32E76", "name": "Producten op houdbaarheid sorteren", "importance": "optioneel", "description": "De houdbaarheidsdatum van alle producten controleren en de producten zodanig rangschikken dat artikelen met de kortste houdbaarheid vooraan staan.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/66862AB419", "name": "Reageren op diefstalpogingen", "importance": "essentieel", "description": "Herkennen van verdachte situaties en direct ingrijpen. Contact opnemen met beveiliging of politie. Incident rapporteren en veiligheidsmaatregelen treffen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6ED242FCC0", "name": "Vakken vullen", "importance": "essentieel", "description": "Netjes in de schappen zetten van producten volgens plan en letten op houdbaarheidsdatum en voorraad.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6B31063647", "name": "Verkoop van artikelen registreren", "importance": "essentieel", "description": "Transacties vastleggen in verkoopadministratie of kassasysteem: artikelgegevens, prijs en datum invoeren. Bonnen afdrukken en betalingen controleren. Rapport maken van de dagomzet.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5EE5C38F8E", "name": "Verkoopgesprekken voeren", "importance": "essentieel", "description": "Benaderen van mogelijke klanten om producten of diensten aan te bieden. Luisteren naar wat de klant nodig heeft en uitleggen wat de voordelen zijn. Afsluiten van de verkoop als doel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01EE09DE07", "name": "Voorraadbehoefte in kaart brengen", "importance": "essentieel", "description": "Inventariseren van voorraadniveaus en inschatten van toekomstige behoeften om tekorten of overschotten te voorkomen.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/24653064A5", "name": "Acquireren", "importance": "enigszins", "descripti