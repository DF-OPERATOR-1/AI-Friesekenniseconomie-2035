[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/25F2044C9F", "name": "Conciërge", "description": "Houdt toezicht, maakt schoon en verricht onderhoudswerkzaamheden in bijvoorbeeld flats, kantoren en scholen. Voorbeelden van werkzaamheden: controleert of bewoners, gebruikers en bezoekers van gebouwen zich aan de huisregels houden en informeert deze mensen over die regels, verwijst en registreert bezoekers, surveilleert, maakt onder andere trappenhuizen en toiletruimten schoon, controleert of schoonmaak- en onderhoudswerkzaamheden goed worden uitgevoerd en verricht onderhoudswerk.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2AC82E47BF", "name": "Activiteitsgegevens bijhouden", "importance": "optioneel", "description": "Registreren van datum, tijd en duur van werkzaamheden. Noteren van betrokken personen en gebruikte middelen. Bijhouden van een overzicht voor rapportage en planning.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/559F00C304", "name": "Afvalsortering controleren", "importance": "optioneel", "description": "Afvalbakken nalopen en kijken of het afval goed is gescheiden. Afwijkingen noteren en rapporteren. Medewerkers uitleg geven als iets niet goed is gegaan. Zorgen voor goede afvalverwerking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/074F2E1358", "name": "Betrokken diensten informeren over problemen en schade", "importance": "essentieel", "description": "Een melding maken van een defect of schade. De juiste afdeling op de hoogte brengen. Uitleggen wat er aan de hand is en wat er nodig is. Een oplossing voorstellen of vragen om hulp.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C6F616F4B8", "name": "Boodschappen doen voor hotelgasten", "importance": "optioneel", "description": "De gewenste boodschappen van gasten noteren en vervolgens de gevraagde producten afleveren op de kamer.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/652091E9CD", "name": "De staat van constructies controleren", "importance": "essentieel", "description": "Inspectie van constructies van diverse materialen (metaal, steen, hout) uitvoeren. Scheuren, verzakkingen en corrosie opsporen. Verslagen maken met aanbevelingen voor onderhoud.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ABD8EC8F73", "name": "Eenvoudige elektrische apparatuur plaatsen", "importance": "optioneel", "description": "Eenvoudige elektrische apparatuur (lampen, stopcontacten en schakelaars) monteren en aansluiten volgens schema en veiligheidsvoorschriften en testen of de apparatuur functioneert.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1AC27F7405", "name": "Gas- Water- en CV installaties controleren en onderhouden", "importance": "optioneel", "description": "Leidingen en gas-, water- en CV-installaties inspecteren op lekkages en slijtage. Filters en pakkingen waar nodig vervangen om te zorgen voor een veilige werking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4AA4339E9D", "name": "Gebouwbeheer inventariseren", "importance": "essentieel", "description": "Door het gebouw lopen en de staat van muren, deuren en installaties bekijken. Gebreken noteren in een overzicht. Inschatten wat onderhoud nodig heeft. Alles duidelijk rapporteren voor planning.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5E45A2041F", "name": "Intern communiceren", "importance": "essentieel", "description": "Opstellen en verspreiden van belangrijke mededelingen binnen de organisatie via e-mail of nieuwsbrieven. Zorgen dat alle collega’s de benodigde informatie ontvangen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7C9AD23B1A", "name": "Klachten behandelen", "importance": "essentieel", "description": "Serieus nemen van klachten van klanten, registreren en zoeken naar een passende oplossing. Ervoor zorgen dat het probleem in de toekomst kan worden voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/428A1B5B5E", "name": "Kluswerk uitvoeren", "importance": "essentieel", "description": "Diverse onderhouds- en reparatiewerkzaamheden verrichten, zoals schilderen, boren of kitten. Materialen en gereedschap selecteren op basis van de taak en het eindresultaat controleren op kwaliteit.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9BE2AE4D5A", "name": "Materieel voor afvalinzameling onderhouden", "importance": "optioneel", "description": "Vuilniswagens en containers regelmatig inspecteren op schade of slijtage. Alles schoonmaken en onderhouden. Defecte onderdelen repareren of vervangen. Zorgen dat het materieel veilig blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/11F89C2E7B", "name": "Mensen de weg wijzen", "importance": "essentieel", "description": "Geven van duidelijke uitleg of aanwijzingen om iemand te helpen bij het vinden van een route of bestemming.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8E1840FE49", "name": "Met gebruikers van gebouwen, leveranciers en onderaannemers communiceren", "importance": "optioneel", "description": "Contact onderhouden met bewoners of huurders om wensen of klachten te inventariseren. Afstemmen met leveranciers en onderaannemers over leveringen en werkafspraken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/580E449A82", "name": "Opruimen en schoonmaken", "importance": "essentieel", "description": "Schoon en netjes maken van ruimtes door bijvoorbeeld te stofzuigen, af te stoffen en afval weg te gooien.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D7CF51CDCE", "name": "Personen verwelkomen", "importance": "optioneel", "description": "Ontvangen van bezoekers en hen vriendelijk doorverwijzen naar de juiste persoon of plek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32E3CE6E8E", "name": "Post ontvangen en verdelen", "importance": "optioneel", "description": "Ontvangen van de post, sorteren en brengen naar de juiste persoon of afdeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/74479CCB6E", "name": "Sleutels beheren van appartementen", "importance": "essentieel", "description": "Een overzicht bijhouden van wie welke sleutel heeft. Sleutels veilig opbergen in een afgesloten ruimte. Bij elke uitgifte en inname noteren wat er gebeurt. Voorkomen dat sleutels kwijtraken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B873840063", "name": "Technisch onderhoud plannen", "importance": "essentieel", "description": "Een schema maken voor periodiek en spoedonderhoud van machines en systemen. Hierbij rekening houden met beschikbare mensen en materialen. Taken prioriteren en veiligheidseisen naleven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/307755765A", "name": "Toezicht houden op gebouwen en eigendommen", "importance": "essentieel", "description": "Rondlopen om te zien of alles in orde en veilig blijft. Controleren van sloten, verlichting en branddeuren, maatregelen nemen bij schade of gevaar en incidenten melden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1A73F9C689", "name": "Tuinen en groenstroken onderhouden", "importance": "optioneel", "description": "Bomen en struiken snoeien, gras maaien en onkruid verwijderen. Nieuwe vegetatie aanplanten en water geven. Paden en terrassen schoonmaken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/46133D052F", "name": "Tussenwanden en valse plafonds verwijderen", "importance": "optioneel", "description": "Bestaande wanden en plafonds demonteren. Bevestigingsmaterialen losmaken en constructies afbreken. Afval volgens de regels sorteren en afvoeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AB18F743AA", "name": "Uitgevoerde prestaties controleren", "importance": "optioneel", "description": "Controleren of werkzaamheden goed en volgens afspraak zijn gedaan. Melden van afwijkingen of verbeterpunten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/361832E31F", "name": "Veiligheidsvoorzieningen controleren", "importance": "essentieel", "description": "Brandblussers, alarmsystemen en nooduitgangen regelmatig testen. Controleren of alles bereikbaar en in goede staat is. Rapporteren van ontbrekende of kapotte voorzieningen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/277832127B", "name": "Zwembaden en badruimtes controleren en onderhouden", "importance": "optioneel", "description": "De waterkwaliteit meten en de pH-waarde en het chloorgehalte controleren. Filters schoonmaken en leidingen inspecteren. Tegels controleren op schade of gladheid. Alles schoon en veilig houden.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "enigszins", "description"