[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/E21A1C1B4D", "name": "Imker", "description": "Houdt bijen voor de zaad- en fruitteelt (bestuiving) en de honing- en wasproductie. Voorbeelden van werkzaamheden: teelt en verzorgt bijen, onderhoudt bijenkasten en -korven, koopt bijenlarven of complete bijenvolken in, verhuurt kasten en korven met bijen aan zaadtelers en fruittelers, haalt honingraten (met een honingslinger) leeg, verkoopt honing, smelt oude raten om tot was (voor de verkoop of om er zelf kaarsen of boenwas van te maken), geeft leiding aan assistenten en houdt de administratie bij.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/11FCBEB603", "name": "Wormenkweker", "description": "Geeft leiding aan een wormenkwekerij en houdt zich bezig met bedrijfsvoering. Voorbeelden van werkzaamheden: bewerkt grond, zet wormen uit, oogst en verkoopt wormen, verricht onderhouds- en reparatiewerk, geeft leiding aan medewerkers en houdt de bedrijfsadministratie bij.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "essentieel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2AC82E47BF", "name": "Activiteitsgegevens bijhouden", "importance": "essentieel", "description": "Registreren van datum, tijd en duur van werkzaamheden. Noteren van betrokken personen en gebruikte middelen. Bijhouden van een overzicht voor rapportage en planning.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3368792922", "name": "Administratie voeren", "importance": "essentieel", "description": "Verzamelen, ordenen en bewaren van financiële gegevens op een overzichtelijke manier. Bijhouden van inkomsten en uitgaven, maken van facturen en voorbereiden van belastingaangiften. Zorgen dat de administratie compleet is en financieel klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BD898FF438", "name": "Administraties van organisaties beheren", "importance": "optioneel", "description": "Facturen, bankafschriften en contracten nauwkeurig invoeren in het systeem. Financiële overzichten en rapportages maken en controleren of alles klopt volgens de wet- en regelgeving.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0740E9C3F9", "name": "Adviseren over verzorging van planten", "importance": "essentieel", "description": "Klanten of collega’s uitleg geven over watergift, bemesting en lichtbehoefte van planten. Uitleggen hoe ziekten voorkomen kunnen worden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "optioneel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/56FB27999F", "name": "Bestellingen plaatsen", "importance": "essentieel", "description": "Controleren van de voorraad en bestellen van de juiste producten of diensten op het juiste moment en bij de juiste leverancier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/43666677E4", "name": "Bestellingen voorbereiden", "importance": "essentieel", "description": "Gekochte producten verzamelen in het magazijn volgens de bestelbonnen. Artikelen controleren op kwaliteit en hoeveelheid. Veilig en netjes inpakken met de juiste labels en verzendinformatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/35CB502585", "name": "Boekhoudkundig beheer uitvoeren", "importance": "essentieel", "description": "Bijhouden van de financiële administratie, verwerken van facturen en maken van financiële rapporten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AF35534187", "name": "Budget beheren", "importance": "essentieel", "description": "Opstellen van een financieel plan en controleren of uitgaven en inkomsten kloppen. Aanpassen van het budget als dat nodig is om overschrijdingen te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B9BD34E2DC", "name": "Dieren doorverwijzen voor gespecialiseerde zorg", "importance": "essentieel", "description": "Gezondheidsstatus beoordelen en vaststellen wanneer extra zorg nodig is. Contact leggen met dierenarts of kliniek. Dieren veilig voorbereiden en overdragen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2ADF242607", "name": "Dieren herindelen", "importance": "optioneel", "description": "Indelen van dieren op soort of kenmerken. Aanpassen van indeling of sorteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FF47D433AA", "name": "Dieren verzorgen", "importance": "essentieel", "description": "De dierenverblijven schoonmaken en de slaapplekken verschonen. Nagels knippen, vacht kammen en de algemene gezondheid controleren. Medische aandacht bieden bij afwijkingen en het tijdig inschakelen van de dierenarts.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/46F2AF3C09", "name": "Dieren voederen", "importance": "essentieel", "description": "Het juiste voedsel en de juiste hoeveelheid klaarmaken volgens schema. Voederplekken schoonhouden. Observeren of alle dieren eten en drinken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9F53B41495", "name": "Dierenverblijven schoonmaken", "importance": "essentieel", "description": "Oude bodembedekking en afval verwijderen uit de verblijven. De kooien, hokken of aquaria desinfecteren en aanvullen met frisse materialen om een hygiënische leefomgeving te bieden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B7E6CC8873", "name": "Geografische of genetische oorsprong controleren van dieren", "importance": "optioneel", "description": "Onderzoeken en controleren van herkomst of afstamming van dieren,  door middel van DNA-onderzoek, documentatiecontrole of andere relevante methoden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/22CC622548", "name": "Gereedschap of materieel onderhouden", "importance": "essentieel", "description": "Gereedschappen inspecteren op slijtage, reinigen en waar nodig repareren of vervangen. Onderhoudsintervallen bijhouden in een logboek", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E84EC935C3", "name": "Goederen opslaan", "importance": "optioneel", "description": "Geleverde producten controleren op hoeveelheid en kwaliteit. Correct registreren en op de juiste plek in het magazijn plaatsen volgens de regels. Voorraden bijhouden zodat alles op peil blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CEBE993BF8", "name": "Hygiënisch werken met dieren", "importance": "essentieel", "description": "Kooien en verblijven van de dieren regelmatig schoonmaken en zo nodig oppervlakken desinfecteren. Protocollen volgen om ziekteverspreiding te voorkomen. Voer en afval op de juiste manier bewaren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5E45A2041F", "name": "Intern communiceren", "importance": "optioneel", "description": "Opstellen en verspreiden van belangrijke mededelingen binnen de organisatie via e-mail of nieuwsbrieven. Zorgen dat alle collega’s de benodigde informatie ontvangen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D1BF525F9B", "name": "Landbouwproducten verkopen en promoten", "importance": "essentieel", "description": "Verkopen van landbouwproducten en ontwikkelen en inzetten van acties om naamsbekendheid te vergroten, meer klanten aan te trekken en de verkoop te stimuleren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2808E2AE1E", "name": "Machines of apparatuur onderhouden", "importance": "essentieel", "description": "Onderhoud uitvoeren: onderdelen controleren, repareren of vervangen. Storingspreventie toepassen om uitval te voorkomen. Onderhoudsrapport bijhouden voor nazorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F877E8EE3C", "name": "Symptomen van ziekte of pijn herkennen bij dieren", "importance": "essentieel", "description": "Het eten, drinken en het verdere gedrag van dieren observeren. Vooral letten op veranderingen zoals lusteloosheid of krabben. Deze signalen rapporteren en eventueel hulp inschakelen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C3D7FC1D0F", "name": "Uitrusting ontsmetten", "importance": "essentieel", "description": "Goed schoonmaken van gebruikte apparatuur en doden van bacteriën met speciale middelen om besmetting te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4A0653B85D", "name": "Voederrantsoenen bepalen voor dieren", "importance": "essentieel", "description": "Het bepalen wat en hoeveel een dier moet eten op basis van soort, leeftijd en activiteit, en het samenstellen van dagrantsoenen. Het aanpassen van het rantsoen bij afwijkingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01EE09DE07", "name": "Voorraadbehoefte in kaart brengen", "importance": "essentieel", "description": "Inventariseren van voorraadniveaus en inschatten van toekomstige behoeften om tekorten of overschotten te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9B7A99ABA2", "name": "Werking van materieel controleren", "importance": "essentieel", "description": "Apparaten, machines en hulpmiddelen inspecteren op veiligheid en functionaliteit. Testen of alle functies correct werken. Defecte onderdelen melden voor reparatie.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/24653064A5", "name": "Acquireren", "importance": "enigszins", "description": "", "code": "100.006.002.004"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "belangrijk", "description": "", "code": "100.001.002.009"}, 