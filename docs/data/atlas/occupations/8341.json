[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/6D8C92CCFF", "name": "Landbouwmachinist", "description": "Bestuurt en bedient verschillende soorten landbouwmachines, zoals tractoren, zaaimachines, oogstmachines en machines voor gewasverzorging. Voorbeelden van werkzaamheden: ploegt en egt landbouwgrond, zaait, poot (aardappels), voert landbouwproducten af per tractor met aanhangwagen of per vrachtwagen en onderhoudt en repareert machines en apparaten (vooral in de winter).", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2B86057F44", "name": "De aard van werkzaamheden bepalen", "importance": "optioneel", "description": "Taken en verantwoordelijkheden van een functie of project in kaart brengen en overleggen met betrokkenen wat er moet gebeuren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/22CC622548", "name": "Gereedschap of materieel onderhouden", "importance": "essentieel", "description": "Gereedschappen inspecteren op slijtage, reinigen en waar nodig repareren of vervangen. Onderhoudsintervallen bijhouden in een logboek", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/596B7AC6BC", "name": "Gewassen oogsten", "importance": "essentieel", "description": "Rijpe gewassen van het veld of uit de boomgaard verzamelen met handgereedschap of machines. Oogststukken sorteren en in kratten of silo’s plaatsen en klaarmaken voor opslag of transport.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/883560A385", "name": "Grondverzetwerken uitvoeren", "importance": "optioneel", "description": "Grond verplaatsen met een graafmachine, bulldozer of kiepwagen. Sleuven graven of kuilen opvullen volgens het plan. Rekening houden met opslag- en stortlocaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/95BE743E66", "name": "Kranen stabiliseren en positioneren", "importance": "essentieel", "description": "Steunpalen en ballast instellen zodat de kraan stevig staat. De hijshaak precies boven de last zetten. Alles controleren voordat het hijsen begint.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6F7B5FB9AE", "name": "Landbouwgrond bewerken", "importance": "essentieel", "description": "De aarde ploegen, frezen en egaliseren voor zaaien of planten. Bodem controleren en eventueel bemesten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A4F5334199", "name": "Landbouwmachines beveiligen", "importance": "essentieel", "description": "Sloten, alarmsystemen en gps-trackers installeren op tractors en machines ter voorkoming van diefstal en vandalisme.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CCD6BCF3D0", "name": "Landbouwmaterieel onderhouden", "importance": "essentieel", "description": "Tractoren en andere machines schoonmaken en controleren. Olie verversen, onderdelen smeren en filters vervangen. Alles klaarmaken voor veilig en goed gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D7AC7D2292", "name": "Landbouwvoertuigen besturen", "importance": "essentieel", "description": "Tractoren, oogstmachines en aanhangers veilig rijden. Route plannen en snelheid aanpassen aan terrein.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C32CB57BE", "name": "Machines bevoorraden", "importance": "essentieel", "description": "Materialen, grondstoffen of onderdelen tijdig bijvullen in machines. Controleren of de juiste voorraadhoeveelheden aanwezig zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01737E39FD", "name": "Machines manoeuvreren", "importance": "essentieel", "description": "Het besturen van machines zoals heftrucks of graafmachines.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3F14106FB3", "name": "Machines transportklaar maken", "importance": "optioneel", "description": "Het reinigen en vastzetten van machines voor vervoer, het demonteren van grote onderdelen, en het beschermen van scherpe randen om schade te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2074CFE942", "name": "Machines verplaatsen over de openbare weg", "importance": "optioneel", "description": "Het regelen van vergunningen, het goed markeren van lading, het plaatsen van waarschuwingsborden, en het zorgen dat de machine veilig en stabiel op de weg staat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3141C97524", "name": "Materieel, grondstoffen en gereedschap klaarzetten", "importance": "essentieel", "description": "Alle benodigde materialen en gereedschappen verzamelen vóór de start van het werk. Controleren of alles compleet en in goede staat is om zonder vertraging te kunnen beginnen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BB3740CD6E", "name": "Personeelsplanning maken", "importance": "optioneel", "description": "Maken van een overzicht van wie wanneer werkt, afgestemd op de beschikbaarheid van medewerkers en de drukte in het bedrijf.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8A1830E3A9", "name": "Sleuven opvullen en aandammen", "importance": "optioneel", "description": "Gevulde sleuf met zand of grond dicht