[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/30314A2D88", "name": "Meteoroloog", "description": "Doet meteorologische waarnemingen en stelt weersverwachtingen op. Voorbeelden van werkzaamheden: bestudeert natuurkundige processen (bijvoorbeeld luchtstromingen en hogedruk- en lagedrukgebieden) en verschijnselen (bijvoorbeeld wolkenvorming, verdamping en straling) in de atmosfeer, krijgt van meetstations op land, op zee en in de lucht waarneemgegevens via computers, satellieten en radars, verwerkt gegevens in computermodellen, (de)codeert waargenomen of ontvangen gegevens en berekent meetgegevens en stelt (voor het wegverkeer en de zee- en luchtvaart) weersverwachtingen op aan de hand van computermodellen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "optioneel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF6AFB2ACF", "name": "Bedrijfsprocedures en werkwijzen toelichten", "importance": "optioneel", "description": "Uitleg geven aan collega’s over taken en regels binnen het bedrijf zodat iedereen goed weet wat te doen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2D9F441739", "name": "Lawinerisico's inschatten", "importance": "optioneel", "description": "Inschatten van lawinegevaar op basis van sneeuw- en ijscondities.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CBB1C6AD0B", "name": "Maritieme voorspellingen doen", "importance": "essentieel", "description": "Maken van voorspellingen over zee- en weersomstandigheden.", "code"