[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/2C5790927D", "name": "Fieldoperator procesindustrie", "description": "Controleert in de procesindustrie (bijvoorbeeld de chemische industrie of de genotsmiddelenindustrie) productieprocessen vanaf de werkvloer. In deze processen verandert de aard van de stoffen. Voorbeelden van werkzaamheden: loopt controlerondes, controleert de afstelling van bijvoorbeeld pompen en kleppen, test productieprocessen, onderzoekt of er lekkages zijn en verricht reparaties en onderhoudswerkzaamheden aan installaties.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "optioneel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B758093EE", "name": "Afwijkingen en productieverstoringen vaststellen", "importance": "essentieel", "description": "Signaleren van fouten of afwijkingen in het productieproces. Documenteren van problemen en onderzoeken van de oorzaak. In kaart brengen van verstoringen om vervolgacties te bepalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF6AFB2ACF", "name": "Bedrijfsprocedures en werkwijzen toelichten", "importance": "optioneel", "description": "Uitleg geven aan collega’s over taken en regels binnen het bedrijf zodat iedereen goed weet wat te doen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F9FA97C153", "name": "Chemische installaties besturen", "importance": "optioneel", "description": "Bedienen en aansturen van installaties voor chemische processen. Controleren van het proces. Werken volgens veiligheidsregels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F0429C4222", "name": "Controleren of aan productienormen wordt voldaan", "importance": "essentieel", "description": "Producten en processen vergelijken met vastgestelde kwaliteitseisen. Eventuele afwijkingen signaleren en rapporteren. Meedenken over verbeteringen om normen blijvend te behalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "optioneel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B3DC6FFB87", "name": "Documentatie raadplegen over de opdracht en de productieaanpak", "importance": "essentieel", "description": "Beschikbare handleidingen en tekeningen lezen om duidelijkheid te krijgen over de opdracht. Processtappen en technische vereisten bestuderen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2B33C09971", "name": "Farmaceutische installaties besturen", "importance": "optioneel", "description": "Aansturen van apparatuur en machines die medicijnen maken. Controleren van kwaliteit. Werken volgens strenge eisen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/768FE22301", "name": "Geautomatiseerde productieapparatuur af- en omstellen", "importance": "essentieel", "description": "Instellingen van robots en machines aanpassen voor een nieuw product. Apparatuur na gebruik veilig uitschakelen. Controleren of alle aanpassingen correct werken voor starten van de productie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/617FE63257", "name": "Gevaarlijk afval sorteren en afvoeren", "importance": "essentieel", "description": "Chemisch of toxisch afval apart verzamelen. Speciaal verpakkingsmateriaal gebruiken volgens voorschriften. Transport en verwerking door erkende partijen regelen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/04BC5BA668", "name": "Installaties in energiecentrales besturen", "importance": "optioneel", "description": "Bedienen en controleren van complexe systemen die energie opwekken en uitleveren. Toezicht houden op het proces en storingen voorkomen. Zorgen dat de centrale veilig en efficiënt werkt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/694A514CC6", "name": "Intern opleiden of on-the-job-training geven", "importance": "optioneel", "description": "Het ontwikkelen van praktijkgerichte trainingen voor collega’s, bijvoorbeeld op het gebied van veiligheid en vervolgens de voortgang tijdens het werk volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "optioneel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D842977A39", "name": "Maatregelen nemen bij incidenten", "importance": "essentieel", "description": "Het snel handelen bij een incident. Het uitvoeren van noodplannen en het inschakelen van hulp om schade te beperken.", "code": ""}, {"uri"