area/7120893B35", "name": "Wiskunde", "importance": "belangrijk", "description": "", "code": "200.0541.01"}]}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/56228E8645", "name": "Productievoorbereider ict", "description": "Controleert of de batchverwerking van gegevens in mainframes (grote centrale computers) op schema ligt en technisch goed verloopt. Voorbeelden van werkzaamheden: analyseert verwerkingsprocessen, stelt productieschema's op, zorgt voor de juiste parameters in het besturingssysteem en verhelpt technische storingen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6C489DB13A", "name": "Back-ups maken", "importance": "essentieel", "description": "Belangrijke bestanden kopiëren naar een veilige plek. Controleren of de back-ups compleet en bruikbaar zijn. Een schema volgen voor regelmatige back-ups. Zorgen dat gegevens bij problemen kunnen worden hersteld.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/396A5DDB37", "name": "Corrigerende maatregelen nemen", "importance": "essentieel", "description": "Ziet waar iets fout gaat, spoort het probleem op en zorgt voor een oplossing om herhaling te voorkomen en zorgt ervoor dat die wordt uitgevoerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A6009D4C25", "name": "Gegevens archiveren", "importance": "essentieel", "description": "Digitale en papieren documenten netjes ordenen en bewaren. Regels volgen over bewaartermijnen en privacy. Alles opslaan op een manier die terugzoeken makkelijk maakt. Regelmatig controleren of de archieven compleet zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3AB72AD050", "name": "ICT-systemen controleren", "importance": "essentieel", "description": "Hardware en software testen op snelheid, betrouwbaarheid en veiligheid. Problemen opsporen en noteren. Verbeteringen voorstellen waar nodig. Zorgen dat alles goed en veilig blijft werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B9475F5FFC", "name": "ICT-systemen implementeren", "importance": "essentieel", "description": "Nieuwe software en apparatuur installeren en instellen. Problemen oplossen tijdens het gebruik. Gebruikers trainen in het omgaan met het systeem. Zorgen dat alles goed werkt binnen de organisatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/41265C49B6", "name": "Informatie verwerken", "importance": "essentieel", "description": "Bekijkt de informatie, ordent deze en zorgt dat het begrijpelijk is voor de mensen die het nodig hebben.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1099C4B0BA", "name": "Onderhoud plannen", "importance": "essentieel", "description": "Opstellen van een schema voor periodieke controles en reparaties. Coördineren van werkzaamheden met interne en externe partijen. Zorgen dat apparatuur en gebouwen in goede staat blijven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7FA7B5DD15", "name": "Productie of implementatie van ICT-systemen coördineren", "importance": "optioneel", "description": "Een plan maken voor het invoeren van een ICT-systeem. Teams aansturen en de voortgang bewaken. Problemen oplossen tijdens het project. Zorgen dat alles op tijd en volgens plan verloopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AA2A10EADA", "name": "Storingen diagnosticeren", "importance": "essentieel", "description": "Technische problemen in machines, apparatuur of systemen onderzoeken. Oorzaken achterhalen en passende oplossingen voorstellen om het werk te kunnen hervatten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FC60FB9A8F", "name": "Voortgang controleren", "importance": "essentieel", "description": "Project- of