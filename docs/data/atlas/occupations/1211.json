[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/B515CC9C46", "name": "Financieel directeur", "description": "Is verantwoordelijk voor de financiën en het bedrijfseconomische beleid van (een grote afdeling van) een organisatie. Voorbeelden van werkzaamheden: stelt financieel beleid op en bewaakt de realisatie hiervan, maakt deel uit van het managementteam en adviseert dit team, stuurt de financiële afdeling(en) en soms ook de ICT-afdeling aan, zorgt voor rapportages en budgetanalyses, houdt zich bezig met belastingen, geldstromen, verzekeringen en financieel-juridische zaken en streeft naar een optimale administratieve organisatie.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/98EBE2BF7A", "name": "Aanbevelingen opstellen", "importance": "essentieel", "description": "Bekijken van gegevens of onderzoeksresultaten en geven van praktische adviezen om een proces, product of dienst te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1AC6E34F43", "name": "Administraties beheren", "importance": "essentieel", "description": "Alle administratiegegevens, zoals facturen, contracten en personeelsdossiers, ordenen en bijhouden. Controleren of de gegevens compleet en correct zijn. Zorgen dat alles voldoet aan interne en externe regelgeving.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/31E6161E74", "name": "Begrotingen opstellen", "importance": "essentieel", "description": "Kijken naar inkomsten en uitgaven en inschatten hoeveel geld nodig is voor een project of periode. Een overzicht maken van posten zoals personeel, materiaal en materiaal.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B5720E9BFA", "name": "Budgettaire aanpassingen doorvoeren", "importance": "essentieel", "description": "Op basis van het budget en de resultaten beslissen welke posten omhoog of omlaag gaan om binnen de financiële kaders te blijven. Wijzigingen in het budget doorvoeren en communiceren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7224E880B7", "name": "Budgetvoorstellen doen", "importance": "essentieel", "description": "Op basis van cijfers en plannen een voorstel maken voor toekomstige inkomsten en uitgaven. Presenteren aan het management met onderbouwing voor elke kostenpost. Vragen beantwoorden en aanpassen waar nodig.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/74A81B523F", "name": "Financiële toestand van organisaties controleren", "importance": "essentieel", "description": "Bekijken en beoordelen van financiële gegevens zoals balansen en winst- en verliesrekeningen. Inzicht krijgen in de financiële gezondheid en stabiliteit van een organisatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1EEDDD6D0E", "name": "Onderhandelen met financiers", "importance": "optioneel", "description": "Praten met investeerders of banken over leningen en voorwaarden. Rente, looptijd en aflossing bespreken om de beste deal te krijgen. Duidelijk uitleggen welk project gefinancierd moet worden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7626967348", "name": "Op financieel beheer toezicht houden", "importance": "essentieel", "description": "Het bewaken van budgetten, uitgaven en inkomsten. Op zoek gaan naar fouten of oneigenlijk gebruik. Afwijkingen rapporteren en correcties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0C2D4A3F30", "name": "Professionele netwerken uitbouwen", "importance": "optioneel", "description": "Bouwt relaties op met mensen en organisaties die belangrijk kunnen zijn voor het werk en onderhoudt deze relaties, bijvoorbeeld via netwerkbijeenkomsten of sociale media.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/52692335DD", "name": "Toezicht houden op administratieve en financiële personeel", "importance": "optioneel", "description": "Begeleiden van medewerkers die werken met cijfers en in de administratie. Controleren of zij de juiste procedures volgen en accuraat werken. Feedback geven en bijsturen waar nodig.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/731774E6C6", "name": "Toezicht houden op audits", "importance": "essentieel", "description": "Zorgen dat controles (audits) volgens de regels verlopen. Controleren of alle stappen worden gevolgd en afwijkingen rapporteren. Advies geven om toekomstige audits beter te laten verlopen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6853740361", "name": "Toezicht houden op efficiënte en doelmatige inzet van (bedrijfs)middelen", "importance": "essentieel", "description": "Controleren wie welke middelen en welk materiaal gebruikt, zoals machines en voertuigen, en nagaan of dat efficiënt gebeurt. Registreren wanneer middelen stilstaan of te veel worden ingezet. Voorstellen doen om het gebruik te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/82D6A81E44", "name": "Toezicht houden op juridisch advies", "importance": "essentieel", "description": "Controleren of het gegeven juridisch advies klopt met wetten en regels. Nagaan of adviezen duidelijk en volledig zijn. Fouten of onduidelijkheden signaleren en terugkoppelen.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "essentieel", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CAC