[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/EC37A9E02B", "name": "Reinigingsmedewerker", "description": "Reinigt de openbare weg, parken en plantsoenen. Voorbeelden van werkzaamheden: leegt containers en vuilnisbakken, haalt vuilniszakken en grofvuil op, veegt straten en wegen, ruimt rommel in parken en plantsoenen op, besproeit onkruid, maakt de openbare ruimte schoon, onderhoudt materieel en strooit eventueel met een strooiwagen tegen gladheid.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F12ABAF0B8", "name": "Afval sorteren en afvoeren", "importance": "optioneel", "description": "Papier, plastic, glas en restafval gescheiden verzamelen. In de juiste containers deponeren. Ophaalschema volgen en lege containers klaarzetten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CD934A5621", "name": "Afval verpakken", "importance": "optioneel", "description": "Afval per soort in stevige zakken of kratten doen. Etiketten plakken en sluiten volgens de regels. Klaarzetten voor afvoer naar inzamelpunt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3262A430E6", "name": "Bewustwording creëren recycling", "importance": "optioneel", "description": "Organiseren van campagnes en activiteiten om mensen bewust te maken van het belang van recycling. Informeren van doelgroepen via educatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/26D4C401F2", "name": "Desinfecteren via verstuiving", "importance": "optioneel", "description": "De verstuiver vullen met een goedgekeurd desinfectiemiddel. De fijne nevel gelijkmatig verspreiden in de ruimte. Het middel laten inwerken en daarna goed ventileren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/517BE0D777", "name": "Klantroutes plannen", "importance": "essentieel", "description": "Beste routes uitzoeken voor leveringen aan klanten. Rekening houden met afstand, verkeer en tijdvensters. Route plannen in het GPS-systeem en bijsturen bij wijzigingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9BE2AE4D5A", "name": "Materieel voor afvalinzameling onderhouden", "importance": "essentieel", "description": "Vuilniswagens en containers regelmatig inspecteren op schade of slijtage. Alles schoonmaken en onderhouden. Defecte onderdelen repareren of vervangen. Zorgen dat het materieel veilig blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3141C97524", "name": "Materieel, grondstoffen en gereedschap klaarzetten", "importance": "essentieel", "description": "Alle benodigde materialen en gereedschappen verzamelen vóór de start van het werk. Controleren of alles compleet en in goede staat is om zonder vertraging te kunnen beginnen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B31594572D", "name": "Onregelmatigheden of storingen signaleren", "importance": "essentieel", "description": "Afwijkingen in apparatuur of processen opmerken door monitoring en testen. Storingsmeldingen vastleggen. Direct doorgeven aan technisch of verantwoordelijk personeel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A650972484", "name": "Openbare ruimten onderhouden", "importance": "essentieel", "description": "Parken, straten en pleinen reinigen. Afval verwijderen, paden vegen en  planten snoeien. Straatmeubilair zoals bankjes en lantaarns repareren. De ruimte schoon en veilig houden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CB57D5A8BF", "name": "Ruimtes schoonmaken en ontsmetten", "importance": "optioneel", "description": "Alle oppervlakken, meubels en vloeren schoonmaken met geschikt middel. Daarna een ontsmettingsmiddel aanbrengen om ziektekiemen te doden. Zorgen dat de ruimte veilig en droog is voordat deze opnieuw wordt gebruikt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0B8B2704C4", "name": "Schoonmaken met behulp van machines", "importance": "optioneel", "description": "Reinigen van oppervlakken en ruimtes met professionele schoonmaakmachines. Gebruiken van geschikte apparatuur per type vervuiling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/83781D91F8", "name": "Vuilnis ophalen", "importance": "essentieel", "description": "Rijden van een vaste route met een vuilniswagen. Leegmaken van containers en vuilnisbakken in de wagen. Scheiden van afval als dat nodig is. Volgen van de regels voor veiligheid en afvalverwerking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A72227EF57", "name": "Wegen onderhouden", "importance": "essentieel", "description": "Uitvoeren van onderhoud en reparaties aan wegen. Zorgen voor goede begaanbaarheid.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "belangrijk", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/4C7E67AD24", "name": "Auditief waarnemen", "importance": "enigszins", "description": "", "code": "100.002.006.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "enigszins", "description": "", "code": "100.003.004.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D71801355A", "name": "Controleren van machines en systemen", "importance": "enigszins", "description": "", "code": "100.002.005.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/9DC1DB64EA", "name": "Creatief denken", "importance": "essentieel", "description": "", "code": "100.003.001.002"}, {"uri": "https://linkeddata.competentnl.nl/id/hu