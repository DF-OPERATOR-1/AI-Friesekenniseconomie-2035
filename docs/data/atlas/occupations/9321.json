[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/24FB08806F", "name": "Inpakker handmatig", "description": "Pakt producten in en verpakt producten met de hand. Voorbeelden van werkzaamheden: verpakt losse artikelen op een geordende manier (afhankelijk van hun aard, vorm en omvang), sorteert losse artikelen met de hand of met gereedschap en doet losse artikelen in kisten, zakken, dozen, blikken, papier, plastic en ander verpakkingsmateriaal.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1CD045C2D0", "name": "Bevoorrading monitoren", "importance": "essentieel", "description": "Bijhouden welke goederen en materialen binnenkomen en op voorraad liggen. Controleren of er genoeg is voor de dagelijkse werkzaamheden. Tijdig bestellen wanneer de voorraad laag wordt, zodat het werk niet stilvalt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/113251EE6B", "name": "Bottelen", "importance": "optioneel", "description": "Vullen van flessen met drank zoals wijn, bier of frisdrank. Afsluiten van flessen met dop of kurk. Zorgen voor een hygiënische en nette afwerking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/58E23A0CF1", "name": "Doorstroom controleren van materiaal of producten", "importance": "optioneel", "description": "Volgen van het productieproces. Controleren of alles goed verloopt. Ingrijpen bij afwijkingen of vertragingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FC53D96AC3", "name": "Etiketteren", "importance": "optioneel", "description": "Labels aanbrengen op producten of dozen met duidelijke tekst en barcodes. Zorgen dat de informatie leesbaar en juist is. Na het plakken controleren of de labels goed vastzitten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E84EC935C3", "name": "Goederen opslaan", "importance": "essentieel", "description": "Geleverde producten controleren op hoeveelheid en kwaliteit. Correct registreren en op de juiste plek in het magazijn plaatsen volgens de regels. Voorraden bijhouden zodat alles op peil blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/27A16B9916", "name": "Goederen sorteren", "importance": "essentieel", "description": "Producten opdelen op maat, soort of kwaliteit. Classificeren volgens codes of kleurmarkeringen om verzending of verdere verwerking te vergemakkelijken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/65FEA31CA3", "name": "Goederen verpakken", "importance": "essentieel", "description": "Producten veilig en efficiënt inpakken volgens de instructies. Verpakkingsmateriaal kiezen dat past bij het product. Klaarmaken voor verzending of opslag met duidelijke labels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "optioneel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C32CB57BE", "name": "Machines bevoorraden", "importance": "optioneel", "description": "Materialen, grondstoffen of onderdelen tijdig bijvullen in machines. Controleren of de juiste voorraadhoeveelheden aanwezig zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/580E449A82", "name": "Opruimen en schoonmaken", "importance": "essentieel", "description": "Schoon en netjes maken van ruimtes door bijvoorbeeld te stofzuigen, af te stoffen en afval weg te gooien.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/298D5C5F3E", "name": "Palleteren", "importance": "optioneel", "description": "Verdelen van een lading gelijkmatig over de pallet om betrouwbaar vast te zetten voor transport en opslag.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/43BCCE52C5", "name": "Producten in verpakkingen plaatsen", "importance": "essentieel", "description": "Verpakken van producten volgens instructies met aandacht voor kwaliteit.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/258016BA7B", "name": "Producten op uiterlijke kenmerken inspecteren", "importance": "essentieel", "description": "Controleren of producten voldoen aan eisen voor kleur, vorm en afwerking. Defecten of afwijkingen signaleren. Goedgekeurde producten doorzetten naar de volgende stap in het proces.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/52F6FFC103", "name": "Productieafval sorteren en afvoeren", "importance": "essentieel", "description": "Verschillende soorten afval (papier, plastic, metaal) scheiden volgens de regels. Afval op een veilige en milieuvriendelijke manier afvoeren. Registreren volgens voorschriften.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0117CED2A6", "name": "Vacuüm verpakken", "importance": "optioneel", "description": "Verpakken van producten door lucht te verwijderen om houdbaarheid te verlengen of om het volume te verkleinen", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4D9396CDCB", "name": "Verpakkingsmateriaal voorbereiden", "importance": "optioneel", "description": "Kiezen en klaarzetten van materiaal zoals dozen, tape en vulmateriaal, zodat ze klaar zijn voor gebruik in het verpakkingsproces.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "enigszins", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D71801355A", "