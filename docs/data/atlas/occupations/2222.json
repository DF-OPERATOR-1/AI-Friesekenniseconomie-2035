[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/4DFDBFDCAB", "name": "Verloskundige", "description": "Begeleidt en controleert vrouwen tijdens de zwangerschap en helpt ze bij de bevalling. Voorbeelden van werkzaamheden: controleert de ligging, groei en hartactiviteit van nog ongeboren baby's, controleert de bloeddruk, de urine en het gewicht van moeders, behandelt zwangerschapsklachten (bijvoorbeeld misselijkheid en maagzuur), adviseert moeders over een gezonde leefwijze, knipt navelstrengen door, controleert nageboorten, hecht wonden als moeders ingescheurd of ingeknipt zijn, onderzoekt en weegt baby's, bindt babynavels af en schrijft verslagen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A2A57955CD", "name": "(Para)medisch doorverwijzen", "importance": "essentieel", "description": "Bepalen of een patiënt extra hulp nodig heeft van een specialist, zoals een fysiotherapeut of psycholoog. Doorsturen van de patiënt daarna.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7CACCD350A", "name": "(Para)medische informatie uitwisselen", "importance": "essentieel", "description": "Belangrijke (para)medische gegevens veilig delen met collega’s en andere zorgverleners. Controleren op volledigheid en juistheid van de informatie en daarbij de vertrouwelijkheid waarborgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3BCB5F31E3", "name": "Activiteiten van gezondheidsinstellingen coördineren", "importance": "optioneel", "description": "Zorgen voor de dagelijkse planning, organisatie en supervisie binnen gezondheidsinstellingen. Efficiency, kwaliteit en veiligheid bewaken volgens protocollen. Verantwoordelijk voor interne en externa communicatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3368792922", "name": "Administratie voeren", "importance": "optioneel", "description": "Verzamelen, ordenen en bewaren van financiële gegevens op een overzichtelijke manier. Bijhouden van inkomsten en uitgaven, maken van facturen en voorbereiden van belastingaangiften. Zorgen dat de administratie compleet is en financieel klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8C441E054F", "name": "Adviseren over verzorging van baby's", "importance": "essentieel", "description": "Ouders tips geven over voeding, slaap en verzorging. Uitleggen wat normaal is in de ontwikkeling. Advies geven bij zorgen of vragen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/DBC1974F2A", "name": "Adviseren over welzijn en gezonde levensstijl", "importance": "essentieel", "description": "Geven van advies over gezondheid, zoals voeding, beweging en omgaan met stress. Helpen van mensen om zich beter te voelen en gezonder te leven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/22C7CC195E", "name": "Betalingen van klanten administreren", "importance": "optioneel", "description": "Noteren van ontvangen betalingen van klanten in het systeem en zorgen dat alle gegevens kloppen en op tijd zijn bijgewerkt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7A4A2CDE7A", "name": "Bevallings- of ouderschapscursussen leiden", "importance": "essentieel", "description": "Geven van cursussen ter voorbereiding op bevalling en ouderschap, met aandacht voor fysieke en emotionele aspecten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1F7FDACFC3", "name": "Bijdragen aan de ontwikkeling van het beroep", "importance": "essentieel", "description": "Deelnemen aan vakbijeenkomsten en delen van kennis via onderzoek, artikelen of netwerken om het beroep verder te verbeteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/35CB502585", "name": "Boekhoudkundig beheer uitvoeren", "importance": "optioneel", "description": "Bijhouden van de financiële administratie, verwerken van facturen en maken van financiële rapporten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1D0D73CF66", "name": "De gezondheidstoestand monitoren", "importance": "essentieel", "description": "Vitale functies zoals bloeddruk en hartslag regelmatig meten om gezondheidsproblemen tijdig waar te nemen. Symptomen noteren en afwijkingen melden. Rapport maken voor vervolgbehandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C7C6294342", "name": "Doorverwijzen binnen de zorgverlening", "importance": "essentieel", "description": "Doorsturen van een patiënt naar een andere zorgverlener of instelling als dat nodig is voor verder onderzoek of behandeling.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A592740D0C", "name": "Eigen deskundigheid ontwikkelen", "importance": "essentieel", "description": "Blijven leren door cursussen, training of ervaring op te doen. Volgen van nieuwe ontwikkelingen in het vak en toepassen in het werk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6AC112CAF9", "name": "Gezondheidsontwikkelingen van baby's monitoren", "importance": "essentieel", "description": "Regelmatig lengte, gewicht en ontwikkeling van baby’s controleren. Alles noteren en vergelijken met groeicurven. Bij zorgen contact opnemen met een arts.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E57B216FB6", "name": "Gynaecologen assisteren bij bevallingen", "importance": "essentieel", "description": "Medische handelingen ondersteunen tijdens de bevalling. De gezondheid van moeder en kind goed in de gaten houden. Snel ingrijpen bij complicaties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/066E8CAC15", "name": "Het geven van borstvoeding ondersteunen", "importance": "essentieel", "description": "Moeders helpen bij het aanleggen van hun baby. Oplossingen bieden bij problemen zoals pijn of weinig melk. Steun geven en vragen beantwoorden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E1705D2290", "name": "Informeren over (para)medische behandelingen", "importance": "essentieel", "description": "Duidelijk uitleggen aan patiënten wat een behandeling inhoudt, wat de voordelen en risico’s zijn en welke keuzes er zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/5F627B547F", "name": "Injecties toedienen", "importance": "essentieel", "description": "Voorbereiden van de injectie met de juiste medicatie en dosering. Injectieplek desinfecteren en naald inbrengen volgens protocol. Patiënt observeren op reacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/03A9521902", "name": "Medisch voorschriften opstellen", "importance": "essentieel", "description": "Diagnose analyseren en de juiste medicatie kiezen. Dosering, frequentie en toedieningsvorm vastleggen. Voorlichting geven over bijwerkingen en interacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B7A8FFA8D", "name": "Medische administratie verwerken", "importance": "essentieel", "description": "Verwerken van patiëntgegevens en medische informatie volgens de regels. Helpen van medisch personeel met administratieve taken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C2CBF3581F", "name": "Medische dossiers bijhouden", "importance": "essentieel", "description": "Patiëntgegevens verzamelen en ordenen op papier of in het zorgsysteem. Medische geschiedenis, onderzoeken en behandelingen bijhouden. Zorgen dat dossiers altijd compleet en up-to-date zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9007E79EC5", "name": "Medische dossiers consulteren", "importance": "essentieel", "description": "Lezen van medische gegevens van een patiënt, zoals testresultaten of eerdere behandelingen. Gebruiken van die informatie om een goede diagnose en behandelplan te maken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A533D363EF", "name": "Monsters van lichaamsvloeistoffen afnemen", "importance": "essentieel", "description": "Bloed, urine of speeksel op de juiste manier verzamelen en labelen. Hygiëne- en veiligheidsmaatregelen volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3E991E491A", "name": "Opleidingen organiseren", "importance": "optioneel", "description": "Het regelen van alles wat nodig is om een opleiding of cursus goed te laten verlopen. Het plannen van de opleiding, het afstemmen met docenten, het zorgen voor lesmateriaal en locaties en het houden van contact met de deelnemers.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1787572A27", "name": "Pijn behandelen", "importance": "essentieel", "description": "Pijnscore meten bij de patiënt en vastleggen. Pijnmedicatie toedienen volgens voorschrift. Effect meten en bijstellen om optimale pijnbestrijding te bereiken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F526370087", "name": "Postnatale revalidatieprogramma's begeleiden", "importance": "essentieel", "description": "Begeleiden van vrouwen bij herstel na de bevalling met oefeningen en advies. Werken aan conditie en welzijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4DA748959B", "name": "Risico's of noodzorgsituaties vaststellen", "importance": "essentieel", "description": "Herkennen van gevaarlijke of spoedeisende situaties die de gezondheid of veiligheid kunnen bedreigen. Melden en actie ondernemen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EA1A24A37C", "name": "Samenwerken aan een gemeenschappelijk doel", "importance": "essentieel", "description": "Samenwerken met anderen aan een gedeeld doel. Gebruiken van ieders kennis en vaardigheden om het plan samen uit te voeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C630A21740", "name": "Specialistische medische behandelingen uitvoeren", "importance": "optioneel", "description": "Complexe medische ingrepen of onderzoeken doen, zoals operaties en therapieën. Resultaten en patiëntreacties beoordelen. Plannen maken voor vervolgbehandelingen op basis van die uitkomsten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C3173B41A", "name": "Verloskundige echo's uitvoeren", "importance": "essentieel", "description": "Uitvoeren van medische echografieën tijdens zwangerschap om ontwikkeling van de foetus te volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0FEFA3FD13", "name": "Verpleegdiagnose stellen", "importance": "essentieel", "description": "Gezondheidstoestand van de patiënt observeren en gegevens verzamelen. Klachten bespreken en vitale functies meten. Op basis daarvan vastleggen welke verpleegkundige zorg nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D9FDFB2CB8", "name": "Zelfstandig een bevalling uitvoeren", "importance": "essentieel", "description": "Een bevalling begeleiden van begin tot eind. De gezondheid van moeder en baby volgen. Medische handelingen uitvoeren en eerste zorg geven na de geboorte.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32B4BECF89", "name": "Zorg afstemmen op de sociale en culturele situatie van de patiënt", "importance": "essentieel", "description": "Achtergrond en gewoonten van de patiënt inventariseren. Behan