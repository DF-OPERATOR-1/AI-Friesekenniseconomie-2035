[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/18F515FBDF", "name": "Afschrijver hout", "description": "Tekent maten af op hout met een kraspen of schrapijzer. Geeft op die manier aan waar gezaagd of geboord moet worden en in welke vorm het hout bewerkt moet worden. Voorbeelden van werkzaamheden: leest tekeningen, beoordeelt houtsoorten en plaatmateriaal en voert eenvoudige metingen en berekeningen uit.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A7E75E4538", "name": "Boomstammen ontschorsen en afkorten", "importance": "essentieel", "description": "Schors verwijderen met speciaal gereedschap en stammen op de juiste lengte zagen. Controleren of oppervlak schoon en egaal is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/42A033748E", "name": "Boomstammen selecteren", "importance": "essentieel", "description": "Stammen beoordelen op soort, formaat en kwaliteit. De beste stammen kiezen voor verdere verwerking of verkoop. Registreren welke stammen geschikt zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/40ADD58D02", "name": "Boomstammen sorteren en opslaan", "importance": "optioneel", "description": "Boomstammen indelen op soort, grootte en kwaliteit. Op een droge, geventileerde plaats opslaan om schimmel en kromtrekken te voorkomen. Registreren waar elke stam ligt voor later gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "optioneel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/65FEA31CA3", "name": "Goederen verpakken", "importance": "optioneel", "description": "Producten veilig en efficiënt inpakken volgens de instructies. Verpakkingsmateriaal kiezen dat past bij het product. Klaarmaken voor verzending of opslag met duidelijke labels.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2808E2AE1E", "name": "Machines of apparatuur onderhouden", "importance": "essentieel", "description": "Onderhoud uitvoeren: onderdelen controleren, repareren of vervangen. Storingspreventie toepassen om uitval te voorkomen. Onderhoudsrapport bijhouden voor nazorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0CB04A123A", "name": "Werkdocumenten invullen en gegevens rapporteren", "importance": "essentieel", "description": "Vereiste formulieren en digitale documenten nauwkeurig invullen met werk- en meetgegevens. Informatie doorsturen naar de juiste afdeling of leidinggevende. Deadlines en procedures volgen bij het rapporteren.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "enigszins", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/9F3480C1E1", "name": "Begrijpend 