[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/5F1F4BAD27", "name": "Bedrijfsleider / ondernemer seksinrichting, escortbedrijf", "description": "Is in het bezit van een gemeentelijke vergunning om een privé-huis, seksclub of escortbedrijf te exploiteren. Voorbeelden van werkzaamheden: ontvangt klanten, verkoopt en serveert dranken, biedt prostituees de gelegenheid om seksuele diensten te verrichten en zorgt voor een veilige en hygiënische werkomgeving.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "optioneel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3368792922", "name": "Administratie voeren", "importance": "essentieel", "description": "Verzamelen, ordenen en bewaren van financiële gegevens op een overzichtelijke manier. Bijhouden van inkomsten en uitgaven, maken van facturen en voorbereiden van belastingaangiften. Zorgen dat de administratie compleet is en financieel klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BD898FF438", "name": "Administraties van organisaties beheren", "importance": "essentieel", "description": "Facturen, bankafschriften en contracten nauwkeurig invoeren in het systeem. Financiële overzichten en rapportages maken en controleren of alles klopt volgens de wet- en regelgeving.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "optioneel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/85F8D9B7BB", "name": "Afrekenen", "importance": "optioneel", "description": "Afrekenen van producten of diensten van een klant, geld ontvangen en zo nodig wisselgeld teruggeven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EDEFE5E12E", "name": "Afspraken inplannen", "importance": "essentieel", "description": "Data en tijden zoeken die passen voor een ontmoeting of vergadering. Deelnemers uitnodigen en benodigde ruimtes of middelen reserveren. Bevestigen en eventuele wijzigingen doorgeven aan alle betrokkenen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EF6AFB2ACF", "name": "Bedrijfsprocedures en werkwijzen toelichten", "importance": "essentieel", "description": "Uitleg geven aan collega’s over taken en regels binnen het bedrijf zodat iedereen goed weet wat te doen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/56FB27999F", "name": "Bestellingen plaatsen", "importance": "essentieel", "description": "Controleren van de voorraad en bestellen van de juiste producten of diensten op het juiste moment en bij de juiste leverancier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "essentieel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/697A5CF306", "name": "Klanten verwelkomen", "importance": "essentieel", "description": "Ontvangen v