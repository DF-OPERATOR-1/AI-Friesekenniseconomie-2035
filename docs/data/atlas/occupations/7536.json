[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/C64506EFF5", "name": "Bedrijfsleider / ondernemer schoenherstellersbedrijf", "description": "Geeft leiding aan een schoenherstellersbedrijf. Voorbeelden van werkzaamheden: instrueert en begeleidt uitvoerend personeel, organiseert en coördineert uiteenlopende werkzaamheden, bewaakt kosten, maakt werkplanningen, onderhandelt met leveranciers, koopt verschillende materialen en machines in, herstelt schoenen, verkoopt, denkt mee over het te voeren personeelsbeleid, houdt financiële administratie bij en bezoekt vakbeurzen.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/D18CB9E1D0", "name": "Lederwarenmaker", "description": "Maakt en bewerkt artikelen van leer (bijvoorbeeld tassen, portemonnees, etuis, ceintuurs en kleding). Werkt in een atelier van een lederwarenbedrijf. Voorbeelden van werkzaamheden: leest werktekeningen, snijdt stukken leer uit, houdt zich bezig met 'omboeken' van leer (de randen omvouwen), stikt leer in elkaar, verft leer, brengt voeringen en tussenbeleg aan, stelt machines in en bedient ze, brengt bijvoorbeeld hengsels, ritssluitingen en versieringen aan, controleert de productkwaliteit, pakt producten in en zet ze klaar voor vervoer.", "tasks": [], "skills": []}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/03B2146A66", "name": "Maatschoenmaker", "description": "Maakt met handgereedschap en machines schoenen op maat en repareert ze. Voorbeelden van werkzaamheden: werkt standaardleesten bij naar de maat en vorm van de voeten (eventueel met een lichte orthopedische afwijking), tekent een patroon van de schoen, stelt een schoenenschacht samen, zet de schoen in elkaar en werkt de schoen af.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3368792922", "name": "Administratie voeren", "importance": "essentieel", "description": "Verzamelen, ordenen en bewaren van financiële gegevens op een overzichtelijke manier. Bijhouden van inkomsten en uitgaven, maken van facturen en voorbereiden van belastingaangiften. Zorgen dat de administratie compleet is en financieel klopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "essentieel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/85F8D9B7BB", "name": "Afrekenen", "importance": "optioneel", "description": "Afrekenen van producten of diensten van een klant, geld ontvangen en zo nodig wisselgeld teruggeven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/43AAF26998", "name": "Artikelen groeperen volgens benodigde reparatie", "importance": "essentieel", "description": "Producten sorteren op soort reparatie, zoals naaien, lijmen of vervangen. Duidelijke stapels maken voor overzicht en voor snel en efficiënt kunnen werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/56FB27999F", "name": "Bestellingen plaatsen", "importance": "essentieel", "description": "Controleren van de voorraad en bestellen van de juiste producten of diensten op het juiste moment en bij de juiste leverancier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AF35534187", "name": "Budget beheren", "importance": "essentieel", "description": "Opstellen van een financieel plan en controleren of uitgaven en inkomsten kloppen. Aanpassen van het budget als dat nodig is om overschrijdingen te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6AC2A3C566", "name": "De kleur van onderdelen van lederwaren herstellen", "importance": "essentieel", "description": "Het oppervlak reinigen en lederverf of -crème in dunne lagen aanbrengen om de kleur van onderdelen van lederwaren te herstellen. Elke laag laten drogen en bijschuren voor een egaal resultaat. De kleur vergelijken met het origineel.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1F1D2DE90D", "name": "Decoraties aanbrengen", "importance": "optioneel", "description": "Ruimtes of objecten versieren volgens thema met slingers, textiel of bloemen. Elementen zorgvuldig bevestigen en rangschikken. Eindresultaat beoordelen op sfeer en evenwicht.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F87CDA9029", "name": "Defecte onderdelen vervangen", "importance": "essentieel", "description": "Slechte onderdelen veilig verwijderen en nieuwe monteren volgens specificatie. Vastzetten en aansluiten zoals bij nieuwbouw. Testen of de vervanging werkt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FC53D96AC3", "name": "Etiketteren", "importance": "optioneel", "description": "Labels aanbrengen op producten of dozen met duidelijke tekst en barcodes. Zorgen dat de informatie leesbaar en juist is. Na het plakken controleren of de labels goed vastzitten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/86CA630EFD", "name": "Gereedschap en hulpmiddelen klaar leggen", "importance": "essentieel", "description": "Inventariseren welke gereedschappen nodig zijn voor de klus. Alles controleren op netheid en werking. De spullen overzichtelijk klaarleggen binnen handbereik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C6A57AF213", "name": "Graveren", "importance": "optioneel", "description": "Het ontwerp of de tekst op het oppervlak aftekenen bij het graveren. Een graveermachine of pen gebruiken om netjes te snijden. Het stof verwijderen en het resultaat controleren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CC5F3C3E96", "name": "Herstelwerk of aanpassingen bepalen van artikelen", "importance": "essentieel", "description": "Elk artikel bekijken en vaststellen wat kapot of versleten is. Bepalen welke reparatie of wijziging nodig is. Een kort plan maken met materialen en tijdsinschatting.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3BD771E14C", "name": "Lederen artikelen vervaardigen", "importance": "essentieel", "description": "Het juiste leer kiezen qua dikte en kleur voor het maken van lederen artikelen zoals tassen, riemen, schoenen en portemonnees. De patroondelen zagen, aan elkaar naaien en de randen afwerken. Controleren of het eindproduct netjes en stevig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0A3B47A9F8", "name": "Lederwaren aanpassen", "importance": "essentieel", "description": "Het lederen product meten en de wensen van de klant bespreken. Delen van tassen, riemen, schoenen en kleding  naaien, knippen of verlengen. Controleren of het goed past en stevig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/192D61A4A9", "name": "Lederwaren oppoetsen", "importance": "essentieel", "description": "Het leer schoonmaken met een zachte doek en reiniger. Ledercrème of -vet aanbrengen en inwrijven met cirkelvormige bewegingen. Het leer laten glanzen met een droge doek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2808E2AE1E", "name": "Machines of apparatuur onderhouden", "importance": "essentieel", "description": "Onderhoud uitvoeren: onderdelen controleren, repareren of vervangen. Storingspreventie toepassen om uitval te voorkomen. Onderhoudsrapport bijhouden voor nazorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/24BE97DDEE", "name": "Offertes opstellen", "importance": "optioneel", "description": "Voorbereiden van een overzichtelijke prijsopgave waarin staat wat een product of dienst kost, afgestemd op de wensen van de klant.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1475F0D1AB", "name": "Onderdelen demonteren", "importance": "essentieel", "description": "Geschikt gereedschap gebruiken om schroeven en klemmen los te maken bij het demonteren van onderdelen. De onderdelen voorzichtig uit elkaar halen. De losse delen geordend bewaren voor hergebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/98504D3746", "name": "Schoen- en lederonderdelen aanbrengen", "importance": "essentieel", "description": "Zolen, hakken en onderdelen van lederwaren naaien, lijmen of nieten volgens het ontwerp. Controleren of alles recht en stevig vastzit. De pasvorm en afwerking controleren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/092AE77CAA", "name": "Schoenen aanpassen", "importance": "essentieel", "description": "De schoen van de klant passen en de pasvorm meten. De wreef of hak vergroten of versmallen met passend materiaal. Controleren of de schoen comfortabel zit.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/7B59C85216", "name": "Schoenen herstellen", "importance": "essentieel", "description": "Versleten zolen of hakken van schoenen vervangen door nieuw materiaal. Losse naden dichtnaaien en de pasvorm controleren. Het leer netjes afwerken met lijm en vet.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D641677B94", "name": "Versterkingsmaterialen aanbrengen", "importance": "optioneel", "description": "Staalplaatjes, houtlatten of stroken aanbrengen op zwakke plekken van constructies. Deze stevig vastzetten met schroeven, bouten of lijm. Controleren of de constructie stevig genoeg is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01EE09DE07", "name": "Voorraadbehoefte in kaart brengen", "importance": "essentieel", "description": "Inventariseren van voorraadniveaus en inschatten van toekomstige behoeften om tekorten of overschotten te voorkomen.", "code": ""}], "skills": [{"uri": "https://linkeddata.competentnl.nl/id/humancapability/DB21DC938E", "name": "Aanpassen aan verandering", "importance": "enigszins", "description": "", "code": "100.001.002.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/21BB252861", "name": "Actief leren", "importance": "enigszins", "description": "", "code": "100.001.002.009"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/8500CACF46", "name": "Actief luisteren", "importance": "belangrijk", "description": "", "code": "100.005.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/EDB4E0C35A", "name": "Anticiperen", "importance": "belangrijk", "description": "", "code": "100.003.005.002"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/AA253D1EBA", "name": "Assertiviteit tonen", "importance": "enigszins", "description": "", "code": "100.001.003.001"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/9F3480C1E1", "name": "Begrijpend lezen", "importance": "belangrijk", "description": "", "code": "100.004.003.003"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/FD015D2B02", "name": "Beslissingen nemen", "importance": "belangrijk", "description": "", "code": "100.003.004.005"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/22799303D1", "name": "Categoriseren", "importance": "enigszins", "description": "", "code": "100.003.002.004"}, {"uri": "https://linkeddata.competentnl.nl/id/humancapability/D71801355A", "name": "Controleren van machines en systemen", "importa