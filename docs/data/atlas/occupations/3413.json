[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/8941F13CF4", "name": "Pastoraal werker", "description": "Begeleidt vanuit de kerk mensen met maatschappelijke, sociale (bijvoorbeeld werklozen of mensen met een huurschuld) en emotionele problemen (bijvoorbeeld relatie- of gedragsproblemen). Voorbeelden van werkzaamheden: gaat voor in de liturgie, begeleidt de catechese, bouwt het jongerenpastoraat uit, wint in gesprekken het vertrouwen van cliënten, legt cliënten uit waarom ze problemen hebben en helpt hen die op te lossen, houdt dossiers bij, schrijft rapporten en overlegt met collega's.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/493165EBCC", "name": "Activiteiten van teams coördineren", "importance": "essentieel", "description": "Het zorgen dat teamleden goed samenwerken en hun werk op elkaar afstemmen. Het bekijken wat er moet gebeuren, het maken van afspraken over wie wat doet en wanneer, en het in de gaten houden of het team op schema blijft. Zo loopt het werk soepel en worden doelen gehaald.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A592740D0C", "name": "Eigen deskundigheid ontwikkelen", "importance": "essentieel", "description": "Blijven leren door cursussen, training of ervaring op te doen. Volgen van nieuwe ontwikkelingen in het vak en toepassen in het werk.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/08917B8C30", "name": "Knelpunten signaleren binnen organisaties", "importance": "essentieel", "description": "Werkprocessen binnen organisaties analyseren door bijvoorbeeld medewerkers te interviewen. Problemen vaststellen en rapporteren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AFA5492C3E", "name": "Liturgische diensten verzorgen", "importance": "essentieel", "description": "Voorbereiden en leiden van religieuze diensten. Kiezen van teksten, muziek en rituelen. Zorgen dat de dienst volgens geloofsregels verloopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E5CDA5B743", "name": "Mensen adviseren over en bewust maken van maatschappelijke thema's", "importance": "essentieel", "description": "Een maatschappelijk thema onderzoeken, zoals armoede of duurzaamheid. Op basis daarvan begrijpelijke folders of presentaties maken voor diverse doelgroepen. Advies geven om bewustwording te vergroten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EC1FD80294", "name": "Mensen begeleiden bij hun individuele groeiproces", "importance": "essentieel", "description": "De persoonlijke en professionele doelen van de persoon bespreken. Met coaching, advies en hulpmiddelen de persoon ondersteunen om de doelen te bereiken. De voortgang regelmatig evalueren en de aanpak bijstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1ABC468719", "name": "Mensen pastoraal begeleiden bij levensvragen", "importance": "essentieel", "description": "Luisteren naar mensen met levensvragen. Bieden van spirituele en emotionele steun via gesprek, gebed of rituelen. Helpen bij het vinden van rust en richting.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/30376B3FB3", "name": "Personen in conflictsituaties adviseren en begeleiden", "importance": "essentieel", "description": "Het luisteren naar alle partijen, het benoemen van kernproblemen, het aanbieden van communicatietechnieken en oplossingen, en het opvolgen en evalueren van conflictvermindering.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3819F9126A", "name": "Persoonlijke situatie en behoeften analyseren", "importance": "essentieel", "description": "Bekijken wat iemand nodig heeft om passende hulp of advies te kunnen geven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupat