[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/C51F4D33C1", "name": "Fotolaborant", "description": "Ontwikkelt filmrolletjes en maakt afdrukken. Voorbeelden van werkzaamheden: bedient computergestuurde machines, drukt foto's af op het gewenste formaat, controleert de kwaliteit van foto's, overlegt met chefs over de kwaliteit van foto's en pakt foto's en negatieven in.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/4B758093EE", "name": "Afwijkingen en productieverstoringen vaststellen", "importance": "essentieel", "description": "Signaleren van fouten of afwijkingen in het productieproces. Documenteren van problemen en onderzoeken van de oorzaak. In kaart brengen van verstoringen om vervolgacties te bepalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/43666677E4", "name": "Bestellingen voorbereiden", "importance": "optioneel", "description": "Gekochte producten verzamelen in het magazijn volgens de bestelbonnen. Artikelen controleren op kwaliteit en hoeveelheid. Veilig en netjes inpakken met de juiste labels en verzendinformatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F0429C4222", "name": "Controleren of aan productienormen wordt voldaan", "importance": "optioneel", "description": "Producten en processen vergelijken met vastgestelde kwaliteitseisen. Eventuele afwijkingen signaleren en rapporteren. Meedenken over verbeteringen om normen blijvend te behalen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/77F9C1D072", "name": "Controles uitvoeren in filmlabs", "importance": "optioneel", "description": "Controleren van processen en apparatuur in een filmlab. Zorgen dat alles veilig en volgens de regels verloopt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "optioneel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ACEFEFC146", "name": "Films en foto's analoog ontwikkelen", "importance": "essentieel", "description": "Ontwikkelen van film en fotorollen  in een donkere kamer. Behandelen met chemicaliën  zichtbare beelden te creëren .", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/84CF5A2CEF", "name": "Foto's digitaal bewerken", "importance": "essentieel", "description": "Bewerken van foto’s met software. Verbeteren van beeldkwaliteit. Klaarmaken voor publicatie.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/87ED6582C8", "name": "Fotografische dragers sorteren", "importance": "essentieel", "description": "Ordenen van negatieven, dia’s of digitale bestanden. Zorgen voor een duidelijk en toegankelijk archief.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B8260683A8", "name": "Machines afstellen", "importance": "essentieel", "description": "Uitleg toevoegen? Kalibreren houdt in dat metingen en instellingen van een machine worden gecontroleerd en aangepast", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/75AC45547D", "name": "Machines of installaties starten en monitoren", "importance": "essentieel", "description": "Opstartprocedures volgen voor veilige inbedrijfstelling. Tijdens gebruik de prestaties en eventuele afwijkingen nauwlettend volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/BEC0303D75", "name": "Milieubewust werken", "importance": "essentieel", "description": "Afval verminderen door materialen te scheiden en hergebruiken waar mogelijk. Energie, water en andere hulpbronnen efficiënt inzetten. Collega’s wijzen op duurzame werkwijzen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/CFF7EA6456", "name": "Ontwikkeling en afdrukken starten van foto's", "importance": "essentieel", "description": "Kiezen van de juiste foto’s en eventueel toepassen van bewerkingen. Starten van het printproces met geschikte apparatuur en materialen. Zorgen voor een goed eindresultaat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8E131B659E", "name": "Ontwikkeling en vermenigvuldiging starten van films", "importance": "essentieel", "description": "Ontwikkeling: Uitwerken van het idee voor de film, een script wordt geschreven en er wordt een team samengesteld.           Vermenigvuldiging van films: Kopiëren en verspreiden van de film naar het gewenste publiek via bioscopen, streamingdiensten of andere platforms.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/F135375D35", "name": "Producten na bereiding verpakken", "importance": "essentieel", "description": "Warme of gekoelde producten hygiënisch verpakken in geschikte materialen. De verpakking goed sluiten en voorzien van label. Alles