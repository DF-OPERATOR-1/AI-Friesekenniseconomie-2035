[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/53B91B6E40", "name": "Allround verpakkingsoperator", "description": "Bedient en bewaakt verpakkingsmachines voor het verpakken van goederen volgens productieplanning. Voorbeelden van werkzaamheden: controleert verpakkingsmaterialen, stelt machines in op het juiste formaat, voert kwaliteitscontroles uit, registreert productiegegevens, reinigt apparatuur en rapporteert afwijkingen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2AC82E47BF", "name": "Activiteitsgegevens bijhouden", "importance": "optioneel", "description": "Registreren van datum, tijd en duur van werkzaamheden. Noteren van betrokken personen en gebruikte middelen. Bijhouden van een overzicht voor rapportage en planning.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/036C07A46A", "name": "De werkplek opruimen en schoonhouden", "importance": "essentieel", "description": "Netjes en schoon houden van de werkplek door op te ruimen, schoon te maken en materialen goed op te bergen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/58E23A0CF1", "name": "Doorstroom controleren van materiaal of producten", "importance": "essentieel", "description": "Volgen van het productieproces. Controleren of alles goed verloopt. Ingrijpen bij afwijkingen of vertragingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/815A4C87C4", "name": "Gereedschap of materieel reinigen", "importance": "essentieel", "description": "Vuil, vet en andere resten van gereedschap en materiaal verwijderen. Geschikte reinigingsmiddelen kiezen en juiste technieken toepassen. Controleren of alles goed droog en gebruiksklaar is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/27A16B9916", "name": "Goederen sorteren", "importance": "essentieel", "description": "Producten opdelen op maat, soort of kwaliteit. Classificeren volgens codes of kleurmarkeringen om verzending of verdere verwerking te vergemakkelijken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9C32CB57BE", "name": "Machines bevoorraden", "importance": "essentieel", "description": "Materialen, grondstoffen of onderdelen tijdig bijvullen in machines. Controleren of de juiste voorraadhoeveelheden aanwezig zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/75AC45547D", "name": "Machines of installaties starten en monitoren", "importance": "essentieel", "description": "Opstartprocedures volgen voor veilige inbedrijfstelling. Tijdens gebruik de prestaties en eventuele afwijkingen nauwlettend volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/32935B5FAC", "name": "Monteren en assembleren", "importance": "optioneel", "description": "Onderdelen op volgorde samenvoegen volgens de werktekening. Gereedschap en machines gebruiken om schroeven en klemmen te bevestigen. Eindproduct controleren op juistheid.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/FF19016781", "name": "Productieverloop bewaken", "importance": "essentieel", "description": "Continu de voortgang van het productieproces volgen. Productie- en kwaliteitsgegevens bijhouden. Bij vertragingen of fouten snel actie ondernemen om op schema te blijven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A3266355FC", "name": "Productieverstoringen oplossen", "importance": "optioneel", "description": "Technische storingen in de productie snel herkennen en analyseren. Direct maatregelen nemen of hulp inschakelen om de storing op te lossen. Zo wordt de normale productie zo snel mogelijk hervat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/9CE06E30C6", "name": "Productieverstoringen rapporteren", "importance": "essentieel", "description": "Storingen in het productieproces vastleggen met oorzaak en impact. Oplossingsvoorstel toevoegen en communiceren met betrokkenen. Rapport bewaren voor vervolgacties.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/361832E31F", "name": "Veiligheidsvoorzieningen controleren", "importance": "essentieel", "description": "Brandblussers, alarmsystemen en nooduitgangen regelmatig testen. Controleren of alles bereikbaar en in goede staat is. Rapporteren van ontbrekende of kapotte voorzieningen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/01EE09DE07", "name": "Voorraadbehoefte in kaart brengen", "importance": "optioneel", "description": "Inventariseren van voorraadniveaus en inschatten van toekomstige behoeften om tekorten of overschotten te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C3410847BD", "name": "Voortgangsrapportages bijhouden", "importance": "essentieel", "description": "De status van taken, deadlines en budgetten van projecten en processen noteren. De rapportage wekelijks of maandelijks bijwerken. De informatie delen met  betrokkenen.", "code": ""}], "skills": [{"uri": "http