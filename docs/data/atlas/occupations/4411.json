[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/1B9A202FB3", "name": "Bibliotheekmedewerker", "description": "Verricht allerlei bibliotheekwerkzaamheden. Voorbeelden van werkzaamheden: bestelt boeken, stelt aanwinstenlijsten op, informeert lezers over boeken, tijdschriften, cd's en ander uitleenmateriaal, maakt hen wegwijs, registreert via een computersysteem het uitlenen en weer innemen van boeken, bestelt, codeert en bindt uitleenmateriaal, maakt titelbeschrijvingen voor de catalogus, herstelt beschadigd uitleenmateriaal en bergt uitleenmateriaal ordelijk op en onderhoudt contacten met andere bibliotheken over onderlinge uitleen.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0A3A5B7504", "name": "Aanbod van informatie optimaal ontsluiten", "importance": "essentieel", "description": "Zorgen dat informatie makkelijk te vinden en te gebruiken is voor uiteenlopende doelgroepen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/1F415D22D8", "name": "Administratieve taken uitvoeren", "importance": "essentieel", "description": "Inkomende en uitgaande post verwerkten, dossiers en archieven beheren. Gegevens in systemen invoeren, rapporten opstellen en ondersteunen bij vergaderingen. Zorgen dat de organisatie overzichtelijk is en de informatie actueel blijft.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EAECE4E2BC", "name": "Collecties of informatieaanbod openstellen voor publiek", "importance": "essentieel", "description": "Selecteren, organiseren en toegankelijk maken van collecties of informatie voor het publiek.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/D1605CE531", "name": "Documenten of informatie klasseren", "importance": "essentieel", "description": "Sorteren van documenten op een logische manier zodat ze makkelijk terug te vinden zijn.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/EEBC6161EE", "name": "Evenementen organiseren", "importance": "essentieel", "description": "Plannen en regelen van alles voor een evenement, zoals de locatie, het budget, de leveranciers, de reclame en de planning. Doel is om het evenement soepel en succesvol te laten verlopen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/15DE815713", "name": "Gebruikers informeren over gebruik van producten of systemen", "importance": "essentieel", "description": "Uitleggen aan klanten hoe een product of systeem stap voor stap werkt. Beantwoorden van vragen en zorgen dat alles duidelijk is voor goed gebruik.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A91B600372", "name": "Gebruikers ondersteunen bij de toepassing van informatiedragers en -middelen", "importance": "essentieel", "description": "Mensen helpen bij het gebruik van boeken, software en andere informatiebronnen door uitleg te geven, technische problemen op te lossen en korte trainingen te geven.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/99EEDB2FBE", "name": "Geleende artikelen registreren en bijhouden", "importance": "essentieel", "description": "Uitgeleende voorwerpen noteren met naam, datum en verwachte retourdatum. De status bijhouden in een registratiesysteem. Herinneringen sturen als iets bijna of te laat wordt teruggebracht.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/C6A17F64AB", "name": "Informatie aanbod actualiseren", "importance": "essentieel", "description": "Controleren of informatie nog actueel en bruikbaar is. Verouderde teksten aanpassen of verwijderen. Nieuwe inhoud toevoegen om het aanbod volledig en up-to-date te houden.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E52ED9081E", "name": "Informatie in archieven verwerven, ontsluiten 