[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/9ECF536CD1", "name": "Rangeerder", "description": "Koppelt en ontkoppelt treindelen. Begeleidt een trein of rangeerdeel. Voorbeelden van werkzaamheden: geeft aanwijzingen aan de machinist, werkt volgens een rangeerplan en veiligheidsvoorschriften, verbindt luchtleidingsslangen (met de hand), controleert of het (ont)koppelen op de juiste manier heeft plaatsgevonden, bestuurt een locomotor en zet treinstellen op het juiste spoor.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3D5B4BE2A9", "name": "Aankomend treinverkeer monitoren en aankondigen op rangeerterrein", "importance": "essentieel", "description": "Observeren van binnenkomend treinverkeer op het rangeerterrein, signaleren van onregelmatigheden en communiceren van aankomst van treinen aan betrokken partijen op en rond het rangeerterrein.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3B65F9EDF2", "name": "Als bestuurder noodzakelijk onderhoud melden", "importance": "optioneel", "description": "Tijdens het rijden of werken storingen en gebreken aan het voertuig signaleren. Onderhouds- of reparatieverzoeken doorgeven aan de juiste afdeling. Waar mogelijk kleine reparaties direct uitvoeren.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/610E0854A7", "name": "Beschadigingen of ongevallen vaststellen en onderzoeken", "importance": "essentieel", "description": "De plek van het ongeval  bekijken en de de beschadigingen aan eigendommen of voertuigen vaststellen en onderzoeken. Betrokkenen spreken en verklaringen noteren. Een rapport schrijven met conclusies en advies.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A1FF6919D5", "name": "Bij calamiteiten maatregelen nemen", "importance": "essentieel", "description": "Snel noodscenario’s beoordelen en veiligheidsplan activeren. Waarschuwen van 