[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/0A1535768D", "name": "Validatie engineer", "description": "Toetst aan de hand van procedures en protocollen of een proces of systeem (bijvoorbeeld een productieproces of een machine) aan de gestelde eisen voldoet. Voorbeelden van werkzaamheden: stelt protocollen op, voert validatie uit op werkprocessen, machines of informatiesystemen, maakt rapportages van de resultaten en geeft aan welke onderdelen verbeterd kunnen worden.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/270E61C426", "name": "Afdelingen of organisaties leiden", "importance": "optioneel", "description": "Het aansturen van een afdeling of organisatie en het zorgen dat doelen worden behaald. Het bepalen waar de organisatie naartoe wil, het maken van plannen, het verdelen van het werk, het nemen van beslissingen en het zorgen dat medewerkers goed samenwerken. Het houden van overzicht en het bijsturen als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0E9FF74145", "name": "Bestekken opstellen (beschrijving van uit te voeren werkzaamheden)", "importance": "optioneel", "description": "Precies opschrijven van welke werkzaamheden uitgevoerd moeten worden, zodat leveranciers weten wat er verwacht wordt.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A2C6DDBD5B", "name": "Certificatiedossiers opstellen", "importance": "essentieel", "description": "Verzamelen en ordenen van documentatie die aantoont dat een product, dienst of organisatie voldoet aan specifieke eisen of normen. Samenstellen van compleet dossier.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/396A5DDB37", "name": "Corrigerende maatregelen nemen", "importance": "essentieel", "description": "Ziet waar iets fout gaat, spoort het probleem op en zorgt voor een oplossing om herhaling te voorkomen en zorgt ervoor 