[{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupation/21BC59F909", "name": "Delfstoffenbewerker", "description": "Bewerkt grove delfstoffen met behulp van machines. Voorbeelden van werkzaamheden: houdt toezicht op een grindwasinstallatie, bedient een kwartszandinstallatie, stelt machines in, stopt materiaal in machines en voert producten af.", "tasks": [{"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/80E3B1B60A", "name": "Afgekeurde producten verwijderen", "importance": "essentieel", "description": "Het inspecteren van producten op fouten, het verwijderen van afgekeurde items, en het zorgen dat de productielijn alleen goedgekeurde goederen doorlaat.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/3E70294093", "name": "Bestellingen ontvangen", "importance": "essentieel", "description": "Binnenkomende goederen vergelijken met de bestelbon. Controleren op aantallen en kwaliteit. Opslaan op de juiste plek en voorraadlijsten bijwerken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/396A5DDB37", "name": "Corrigerende maatregelen nemen", "importance": "optioneel", "description": "Ziet waar iets fout gaat, spoort het probleem op en zorgt voor een oplossing om herhaling te voorkomen en zorgt ervoor dat die wordt uitgevoerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/66E74B9982", "name": "De grondstoftoevoer van de machines controleren", "importance": "essentieel", "description": "Het in de gaten houden of machines voldoende grondstof krijgen, het bijvullen waar nodig, en het oplossen van storingen om productie stilstand te voorkomen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/ED53143028", "name": "De voorraad beheren", "importance": "optioneel", "description": "Bijhouden van wat er op voorraad is, controleren van de kwaliteit en op tijd bestellen van nieuwe producten als dat nodig is.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/A14F4FBC84", "name": "Eerstelijnsonderhoud aan machines of installaties uitvoeren", "importance": "essentieel", "description": "Basisonderhoud uitvoeren door onderdelen te smeren, filters te vervangen en kleine reparaties te doen. Machines en installaties regelmatig controleren op slijtage. Zo blijft de apparatuur betrouwbaar werken.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/517BE0D777", "name": "Klantroutes plannen", "importance": "essentieel", "description": "Beste routes uitzoeken voor leveringen aan klanten. Rekening houden met afstand, verkeer en tijdvensters. Route plannen in het GPS-systeem en bijsturen bij wijzigingen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/8263E0CA08", "name": "Kwaliteitscontroles uitvoeren", "importance": "essentieel", "description": "Geproduceerde goederen, diensten of processen inspecteren op kwaliteit en specificaties. Afwijkingen signaleren en direct corrigerende acties voorstellen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/B8260683A8", "name": "Machines afstellen", "importance": "essentieel", "description": "Uitleg toevoegen? Kalibreren houdt in dat metingen en instellingen van een machine worden gecontroleerd en aangepast", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/E009E24463", "name": "Machines en apparaten instellen", "importance": "essentieel", "description": "Juiste instellingen en parameters invoeren op machines en apparaten. Controleren of alles goed functioneert voordat de productie start. Zo wordt optimale prestatie verzekerd.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/2808E2AE1E", "name": "Machines of apparatuur onderhouden", "importance": "essentieel", "description": "Onderhoud uitvoeren: onderdelen controleren, repareren of vervangen. Storingspreventie toepassen om uitval te voorkomen. Onderhoudsrapport bijhouden voor nazorg.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/75AC45547D", "name": "Machines of installaties starten en monitoren", "importance": "essentieel", "description": "Opstartprocedures volgen voor veilige inbedrijfstelling. Tijdens gebruik de prestaties en eventuele afwijkingen nauwlettend volgen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/96409F7516", "name": "Productiegegevens analyseren", "importance": "essentieel", "description": "Gegevens uit de productieprocessen verzamelen en verwerken. Trends en afwijkingen signaleren. Rapporteren met aanbevelingen voor verbeteringen.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/6B430275C7", "name": "Productiegereedschappen (de)monteren en afstellen", "importance": "essentieel", "description": "Gereedschappen voor productie vakkundig monteren en demonteren. Nauwkeurig afstellen zodat machines optimaal werken. Controle uitvoeren op juiste werking.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/AA2A10EADA", "name": "Storingen diagnosticeren", "importance": "essentieel", "description": "Technische problemen in machines, apparatuur of systemen onderzoeken. Oorzaken achterhalen en passende oplossingen voorstellen om het werk te kunnen hervatten.", "code": ""}, {"uri": "https://linkeddata.competentnl.nl/id/uwv/occupationcharacteristic/0CB04A123A", "name": "Werkdocumenten invullen en gegevens rapporteren", "importance": "essentieel", "description": "Vereiste formulieren en digitale documenten nauwkeurig invullen met werk- en meetgegevens. Informatie doorsturen naar de juiste afdeling of leidinggevende. Deadlines en procedures volgen bij het rapporteren.", "code": ""}], "skills": [{"uri": "https://linkeddata.compete